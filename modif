Par exemple :

"use client"

import { useEffect, useState } from "react"

import Breadcrumb from "./Breadcrumb"
import FolderTree from "./FolderTree"
import FileList from "./FileList"

import type { Folder, DocumentFile } from "@/lib/types"

export default function FileManager() {

  const [folders, setFolders] = useState<Folder[]>([])
  const [files, setFiles] = useState<DocumentFile[]>([])

  const [selectedFolderId, setSelectedFolderId] =
    useState<number | null>(null)

  useEffect(() => {
    loadFolders()
  }, [])

  async function loadFolders() {

    const response = await fetch(
      "https://localhost:7001/api/folders"
    )

    if (!response.ok) {
      throw new Error("Impossible de charger les dossiers")
    }

    const data: Folder[] = await response.json()

    setFolders(data)

    // Sélectionner le dossier racine
    const rootFolder = data.find(
      folder => folder.parentId === null
    )

    if (rootFolder) {
      setSelectedFolderId(rootFolder.id)
    }
  }

  useEffect(() => {

    if (selectedFolderId === null) {
      return
    }

    loadFiles(selectedFolderId)

  }, [selectedFolderId])

  async function loadFiles(folderId: number) {

    const response = await fetch(
      `https://localhost:7001/api/files/folder/${folderId}`
    )

    if (!response.ok) {
      throw new Error("Impossible de charger les fichiers")
    }

    const data: DocumentFile[] =
      await response.json()

    setFiles(data)
  }

  return (
    <div className="document-Layout">

      {/* SIDEBAR */}
      <aside className="docs-sidebar">

        <div className="sidebar-title">
          Documents
        </div>

        <FolderTree
          folders={folders}
          selectedFolderId={selectedFolderId}
          onSelect={setSelectedFolderId}
        />

      </aside>

      {/* CONTENU */}
      <main className="docs-content">

        <h1 className="docs-page-title">
          Gestionnaire de fichiers
        </h1>

        {/* CHEMIN COMPLET */}
        <Breadcrumb
          folders={folders}
          selectedFolderId={selectedFolderId}
          onNavigate={(folderId) => {
            setSelectedFolderId(folderId)
          }}
        />

        {/* FICHIERS */}
        <FileList
          files={files}
        />

      </main>

    </div>
  )
}


