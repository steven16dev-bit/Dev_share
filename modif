5. Fonction nouvel onglet

function openInNewTab() {

    if (!currentDocument) {
        return;
    }


    window.open(
        currentDocument.url,
        "_blank"
    );

}


---

6. Fonction plein écran

function fullscreenViewer() {

    const viewer =
        document.getElementById(
            "pdfViewerPanel"
        );

    if (!viewer) {
        return;
    }


    if (!document.fullscreenElement) {

        viewer.requestFullscreen();

    } else {

        document.exitFullscreen();

    }

}


