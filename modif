@media (max-width: 500px) {

    .apps-panel {
        top: 68px;

        left: 50%;

        width: calc(100vw - 16px);
        max-width: none;

        transform: translateX(-50%);

        padding: 16px;

        border-radius: 14px;
    }

    .apps-grid {
        grid-template-columns: repeat(4, 1fr);

        gap: 18px 4px;
    }

    .app-icon {
        width: 42px;
        height: 42px;
    }

    .apps-grid a {
        font-size: 11px;
    }
}