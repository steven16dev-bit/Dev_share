4. openViewer()

Utilisez cette version :

function openViewer(id) {

    const selectedFile =
        documents.find(
            file => file.id === id
        );

    if (!selectedFile) {
        return;
    }


    /* Mobile */

    if (
        window.matchMedia(
            "(max-width: 800px)"
        ).matches
    ) {

        window.open(
            selectedFile.url,
            "_blank"
        );

        return;
    }


    currentDocument =
        selectedFile;


    const layout =
        document.getElementById(
            "mainLayout"
        );

    const viewer =
        document.getElementById(
            "pdfViewerPanel"
        );

    const pdf =
        document.getElementById(
            "pdfViewer"
        );

    const title =
        document.getElementById(
            "viewerTitle"
        );


    title.textContent =
        selectedFile.name;


    pdf.src =
        selectedFile.url +
        "#toolbar=1&navpanes=1";


    /*
       IMPORTANT :

       Les deux classes sont ajoutées
       immédiatement.

       Donc le déplacement du contenu
       et l'ouverture du viewer commencent
       exactement au même moment.
    */

    layout.classList.add(
        "viewer-open"
    );

    viewer.classList.add(
        "open"
    );

}


---

5. closeViewer()

C'est ici que nous corrigeons votre problème.

Ne mettez plus de setTimeout() pour fermer le layout.

function closeViewer() {

    const layout =
        document.getElementById(
            "mainLayout"
        );

    const viewer =
        document.getElementById(
            "pdfViewerPanel"
        );

    const pdf =
        document.getElementById(
            "pdfViewer"
        );


    /*
       IMPORTANT :

       Les deux commencent leur animation
       exactement au même moment.
    */

    viewer.classList.remove(
        "open"
    );

    layout.classList.remove(
        "viewer-open"
    );


    /*
       On attend uniquement la fin
       visuelle de l'animation pour
       libérer le PDF.
    */

    setTimeout(() => {

        pdf.src = "";

        currentDocument = null;

    }, 400);

}


