Oui. Tu peux supprimer toute la logique UpdateDescendantFilePathsAsync() et la remplacer par un simple REPLACE.

Dans FolderService.cs, dans RenameAsync, remplace ton ancienne méthode par celle-ci :

public async Task RenameAsync(long folderId, string newName)
{
    if (string.IsNullOrWhiteSpace(newName))
        throw new Exception("Le nom du dossier est obligatoire.");

    newName = newName.Trim();

    await using var connection = _factory.Create();
    await connection.OpenAsync();

    await using var transaction =
        (OracleTransaction)await connection.BeginTransactionAsync();

    try
    {
        // 1. Récupérer le dossier
        const string selectSql = """
            SELECT NAME, PARENT_ID
            FROM FILE_FOLDERS
            WHERE ID = :id
            """;

        string oldName;
        long? parentId;

        await using (var command =
            new OracleCommand(selectSql, connection))
        {
            command.Transaction = transaction;

            command.Parameters.Add(
                "id",
                OracleDbType.Int64
            ).Value = folderId;

            await using var reader =
                await command.ExecuteReaderAsync();

            if (!await reader.ReadAsync())
                throw new Exception("Dossier introuvable.");

            oldName = reader.GetString(0);

            parentId = reader.IsDBNull(1)
                ? null
                : reader.GetInt64(1);
        }

        // 2. Vérifier qu'un autre dossier porte déjà ce nom
        const string duplicateSql = """
            SELECT COUNT(*)
            FROM FILE_FOLDERS
            WHERE NAME = :name
              AND (
                    PARENT_ID = :parentId
                    OR (PARENT_ID IS NULL AND :parentId IS NULL)
                  )
              AND ID <> :id
            """;

        await using (var command =
            new OracleCommand(duplicateSql, connection))
        {
            command.Transaction = transaction;

            command.Parameters.Add(
                "name",
                OracleDbType.Varchar2
            ).Value = newName;

            command.Parameters.Add(
                "parentId",
                OracleDbType.Int64
            ).Value = parentId ?? (object)DBNull.Value;

            command.Parameters.Add(
                "id",
                OracleDbType.Int64
            ).Value = folderId;

            var count =
                Convert.ToInt32(
                    await command.ExecuteScalarAsync()
                );

            if (count > 0)
                throw new Exception(
                    $"Un dossier nommé '{newName}' existe déjà."
                );
        }

        // 3. Calculer les anciens et nouveaux chemins physiques
        var oldFolderPath =
            await GetFolderPhysicalPathAsync(folderId);

        var newFolderPath =
            Path.Combine(
                Directory.GetParent(oldFolderPath)!.FullName,
                SanitizeFolderName(newName)
            );

        // 4. Vérifier que le dossier physique existe
        if (!Directory.Exists(oldFolderPath))
            throw new DirectoryNotFoundException(
                $"Le dossier physique n'existe pas : {oldFolderPath}"
            );

        // 5. Vérifier que le nouveau chemin n'existe pas
        if (Directory.Exists(newFolderPath))
            throw new Exception(
                $"Le dossier physique '{newName}' existe déjà."
            );

        // 6. Renommer physiquement
        Directory.Move(
            oldFolderPath,
            newFolderPath
        );

        try
        {
            // 7. Mettre à jour le nom dans Oracle
            const string updateFolderSql = """
                UPDATE FILE_FOLDERS
                SET NAME = :name,
                    UPDATED_AT = SYSTIMESTAMP
                WHERE ID = :id
                """;

            await using (var command =
                new OracleCommand(
                    updateFolderSql,
                    connection))
            {
                command.Transaction = transaction;

                command.Parameters.Add(
                    "name",
                    OracleDbType.Varchar2
                ).Value = newName;

                command.Parameters.Add(
                    "id",
                    OracleDbType.Int64
                ).Value = folderId;

                await command.ExecuteNonQueryAsync();
            }

            // 8. Mettre à jour les FILE_PATH
            //    de tous les fichiers du dossier
            //    et de ses sous-dossiers.
            const string updatePathsSql = """
                UPDATE FILE_DOCUMENTS
                SET FILE_PATH = REPLACE(
                    FILE_PATH,
                    :oldPath,
                    :newPath
                )
                WHERE FILE_PATH LIKE :oldPathLike
                """;

            await using (var command =
                new OracleCommand(
                    updatePathsSql,
                    connection))
            {
                command.Transaction = transaction;

                command.Parameters.Add(
                    "oldPath",
                    OracleDbType.Varchar2
                ).Value = oldFolderPath;

                command.Parameters.Add(
                    "newPath",
                    OracleDbType.Varchar2
                ).Value = newFolderPath;

                command.Parameters.Add(
                    "oldPathLike",
                    OracleDbType.Varchar2
                ).Value = oldFolderPath + "%";

                await command.ExecuteNonQueryAsync();
            }

            // 9. Valider la transaction
            await transaction.CommitAsync();
        }
        catch
        {
            // Si Oracle échoue,
            // on remet le dossier à son ancien nom
            if (Directory.Exists(newFolderPath) &&
                !Directory.Exists(oldFolderPath))
            {
                Directory.Move(
                    newFolderPath,
                    oldFolderPath
                );
            }

            throw;
        }
    }
    catch
    {
        try
        {
            await transaction.RollbackAsync();
        }
        catch
        {
            // Ignorer l'erreur de rollback
        }

        throw;
    }
}

Tu peux supprimer complètement

Cette ancienne méthode n'est plus nécessaire :

UpdateDescendantFilePathsAsync(...)

Et surtout, tu n'as plus besoin de faire :

GetFolderPhysicalPathAsync(file.FolderId)

pour chaque fichier.

Le fonctionnement devient simplement :

Renommer D1 → D1_Nouveau
        │
        ├── Directory.Move()
        │
        ├── UPDATE FILE_FOLDERS
        │      NAME = 'D1_Nouveau'
        │
        └── UPDATE FILE_DOCUMENTS
               FILE_PATH =
               REPLACE(FILE_PATH, ancien chemin, nouveau chemin)

Ainsi, si tu as :

D1/
 ├── fichier1.pdf
 └── D2/
      └── fichier2.pdf

les deux FILE_PATH sont automatiquement corrigés, y compris ceux des sous-dossiers.


