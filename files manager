18. FolderTree avec Drag & Drop

components/FolderTree.tsx

"use client"

import { useMemo, useState } from "react"

import { Folder } from "@/lib/types"

interface Props {
  folders: Folder[]
  selectedId: number | null
  onSelect: (folder: Folder) => void
  onContextMenu: (
    event: React.MouseEvent,
    folder: Folder
  ) => void
  onMove: (
    folder: Folder,
    target: Folder
  ) => void
}

export default function FolderTree({
  folders,
  selectedId,
  onSelect,
  onContextMenu,
  onMove
}: Props) {

  const [dragged, setDragged] =
    useState<Folder | null>(null)

  function children(parentId: number | null) {
    return folders.filter(
      folder =>
        folder.parentId === parentId
    )
  }

  function isDescendant(
    source: Folder,
    target: Folder
  ) {

    let current =
      target.parentId

    while (current !== null) {

      if (current === source.id)
        return true

      const folder =
        folders.find(
          f => f.id === current
        )

      current =
        folder?.parentId ?? null
    }

    return false
  }

  function render(
    parentId: number | null,
    level = 0
  ) {

    return children(parentId)
      .map(folder => (

        <div key={folder.id}>

          <div
            className={
              `folder-item ${
                selectedId === folder.id
                  ? "selected"
                  : ""
              }`
            }

            style={{
              paddingLeft:
                14 + level * 20
            }}

            draggable

            onDragStart={() =>
              setDragged(folder)
            }

            onDragEnd={() =>
              setDragged(null)
            }

            onDragOver={e =>
              e.preventDefault()
            }

            onDrop={e => {

              e.preventDefault()

              if (
                dragged &&
                dragged.id !== folder.id &&
                !isDescendant(
                  dragged,
                  folder
                )
              ) {
                onMove(
                  dragged,
                  folder
                )
              }

              setDragged(null)
            }}

            onClick={() =>
              onSelect(folder)
            }

            onContextMenu={e =>
              onContextMenu(
                e,
                folder
              )
            }
          >

            <span className="folder-chevron">
              {children(folder.id).length
                ? "›"
                : ""}
            </span>

            <span className="folder-icon">
              📁
            </span>

            <span className="folder-name">
              {folder.name}
            </span>

            {selectedId === folder.id && (
              <span className="folder-dot">
                ●
              </span>
            )}

          </div>

          {render(
            folder.id,
            level + 1
          )}

        </div>

      ))
  }

  return (
    <div className="folder-tree">
      {render(null)}
    </div>
  )
}


