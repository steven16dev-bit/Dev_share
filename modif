4. Dans FileManager.tsx

Comme tu avais le problème de selectedFolderId, je te conseille de passer explicitement le dossier :

async function uploadFilesToFolder(files: File[]) {
  if (selectedFolderId === null) {
    setError("Veuillez sélectionner un dossier.")
    return
  }

  try {
    setLoading(true)
    setError("")

    await uploadFiles(
      selectedFolderId,
      files
    )

    await loadFiles(
      selectedFolderId,
      page,
      pageSize
    )
  }
  catch (err) {
    setError(
      err instanceof Error
        ? err.message
        : "Erreur lors de l'upload."
    )
  }
  finally {
    setLoading(false)
  }
}

