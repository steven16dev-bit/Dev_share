3. openViewer()

function openViewer(id) {

    const selectedFile = documents.find(
        file => file.id === id
    );

    if (!selectedFile) return;


    /* Mobile */

    if (
        window.matchMedia("(max-width: 800px)").matches
    ) {

        window.open(
            selectedFile.url,
            "_blank"
        );

        return;
    }


    currentDocument = selectedFile;


    const layout =
        document.getElementById("mainLayout");

    const viewer =
        document.getElementById("pdfViewerPanel");

    const pdf =
        document.getElementById("pdfViewer");

    const title =
        document.getElementById("viewerTitle");


    title.textContent =
        selectedFile.name;


    pdf.src =
        selectedFile.url +
        "#toolbar=1&navpanes=1";


    /*
       Les deux changements sont déclenchés
       exactement dans la même frame.
    */

    requestAnimationFrame(() => {

        layout.classList.add("viewer-open");

        viewer.classList.add("open");

    });

}


