JavaScript

Modifiez simplement :

const NEWS_PER_PAGE = 4;

Puis votre pagination :

function renderNewsPagination() {

    const pagination =
        document.getElementById(
            "newsPagination"
        );

    if (!pagination) return;

    pagination.innerHTML = "";

    const totalPages =
        Math.ceil(
            articles.length /
            NEWS_PER_PAGE
        );


    if (totalPages <= 1) {
        pagination.style.visibility =
            "hidden";

        return;
    }


    pagination.style.visibility =
        "visible";


    /* Précédent */

    const previous =
        document.createElement("button");

    previous.className =
        "news-page-btn";

    previous.textContent = "‹";

    previous.disabled =
        currentNewsPage === 1;

    previous.onclick = () => {

        if (currentNewsPage > 1) {

            currentNewsPage--;

            renderNews();

        }

    };

    pagination.appendChild(previous);


    /* Numéros */

    for (
        let page = 1;
        page <= totalPages;
        page++
    ) {

        const button =
            document.createElement("button");

        button.className =
            "news-page-btn";

        button.textContent =
            page;


        if (
            page === currentNewsPage
        ) {

            button.classList.add(
                "active"
            );

        }


        button.onclick = () => {

            currentNewsPage =
                page;

            renderNews();

        };


        pagination.appendChild(button);

    }


    /* Suivant */

    const next =
        document.createElement("button");

    next.className =
        "news-page-btn";

    next.textContent = "›";

    next.disabled =
        currentNewsPage === totalPages;


    next.onclick = () => {

        if (
            currentNewsPage <
            totalPages
        ) {

            currentNewsPage++;

            renderNews();

        }

    };


    pagination.appendChild(next);
}

