4. Remplacez closeViewer()

function closeViewer() {

    const viewer =
        document.getElementById(
            "pdfViewerPanel"
        );

    const pdf =
        document.getElementById(
            "pdfViewer"
        );

    const layout =
        document.querySelector(
            ".layout"
        );


    if (!viewer || !layout) {
        return;
    }


    /*
       Commencer l'animation
    */

    viewer.classList.remove("open");


    /*
       Après l'animation,
       supprimer la colonne du viewer
    */

    setTimeout(() => {

        layout.classList.remove(
            "viewer-open"
        );


        if (pdf) {
            pdf.src = "";
        }


        currentDocument = null;


        const title =
            document.getElementById(
                "viewerTitle"
            );

        if (title) {

            title.textContent =
                "Aucun document sélectionné";

        }

    }, 350);

}


