"use client";

import { useMemo, useState } from "react";
import styles from "./actualites.module.css";

export interface Actualite {
  id: number;
  titre: string;
  description: string;
  paragraphe: string;
  categorie: string;
  date: string;
  motsCles: string[];
}

interface Props {
  actualites: Actualite[];
  onAjouter: () => void;
  onModifier: (actualite: Actualite) => void;
  onSupprimer: (id: number) => void;
}

const PAGE_SIZE = 5;

export default function ActualitesTable({
  actualites,
  onAjouter,
  onModifier,
  onSupprimer,
}: Props) {
  const [recherche, setRecherche] = useState("");
  const [categorie, setCategorie] = useState("Toutes");
  const [page, setPage] = useState(1);

  const categories = useMemo(() => {
    return [
      "Toutes",
      ...Array.from(
        new Set(actualites.map((actualite) => actualite.categorie))
      ),
    ];
  }, [actualites]);

  const actualitesFiltrees = useMemo(() => {
    const terme = recherche.toLowerCase().trim();

    return actualites.filter((actualite) => {
      const correspondRecherche =
        !terme ||
        actualite.titre.toLowerCase().includes(terme) ||
        actualite.description.toLowerCase().includes(terme) ||
        actualite.motsCles.some((mot) =>
          mot.toLowerCase().includes(terme)
        );

      const correspondCategorie =
        categorie === "Toutes" ||
        actualite.categorie === categorie;

      return correspondRecherche && correspondCategorie;
    });
  }, [actualites, recherche, categorie]);

  const totalPages = Math.max(
    1,
    Math.ceil(actualitesFiltrees.length / PAGE_SIZE)
  );

  const actualitesPage = actualitesFiltrees.slice(
    (page - 1) * PAGE_SIZE,
    page * PAGE_SIZE
  );

  const changerRecherche = (value: string) => {
    setRecherche(value);
    setPage(1);
  };

  const changerCategorie = (value: string) => {
    setCategorie(value);
    setPage(1);
  };

  const formaterDate = (date: string) => {
    return new Intl.DateTimeFormat("fr-FR").format(
      new Date(date)
    );
  };

  return (
    <section className={styles.container}>
      {/* HEADER */}
      <div className={styles.header}>
        <div>
          <h1 className={styles.title}>Actualités</h1>
          <p className={styles.subtitle}>
            Gestion des actualités du portail
          </p>
        </div>

        <button
          className={styles.addButton}
          onClick={onAjouter}
        >
          <span>+</span>
          Ajouter
        </button>
      </div>

      {/* FILTRES */}
      <div className={styles.toolbar}>
        <div className={styles.searchContainer}>
          <span className={styles.searchIcon}>⌕</span>

          <input
            type="text"
            value={recherche}
            onChange={(e) =>
              changerRecherche(e.target.value)
            }
            placeholder="Rechercher une actualité..."
            className={styles.searchInput}
          />
        </div>

        <select
          value={categorie}
          onChange={(e) =>
            changerCategorie(e.target.value)
          }
          className={styles.categorySelect}
        >
          {categories.map((item) => (
            <option key={item} value={item}>
              {item}
            </option>
          ))}
        </select>
      </div>

      {/* TABLE */}
      <div className={styles.tableContainer}>
        <table className={styles.table}>
          <thead>
            <tr>
              <th>Titre</th>
              <th>Catégorie</th>
              <th>Date</th>
              <th>Mots clés</th>
              <th className={styles.actionsHeader}>
                Actions
              </th>
            </tr>
          </thead>

          <tbody>
            {actualitesPage.length > 0 ? (
              actualitesPage.map((actualite) => (
                <tr key={actualite.id}>
                  <td>
                    <div className={styles.titleCell}>
                      <strong>{actualite.titre}</strong>

                      <span>
                        {actualite.description}
                      </span>
                    </div>
                  </td>

                  <td>
                    <span className={styles.categoryBadge}>
                      {actualite.categorie}
                    </span>
                  </td>

                  <td className={styles.dateCell}>
                    {formaterDate(actualite.date)}
                  </td>

                  <td>
                    <div className={styles.tags}>
                      {actualite.motsCles
                        .slice(0, 3)
                        .map((mot) => (
                          <span
                            key={mot}
                            className={styles.tag}
                          >
                            {mot}
                          </span>
                        ))}
                    </div>
                  </td>

                  <td>
                    <div className={styles.actions}>
                      <button
                        className={`${styles.actionButton} ${styles.editButton}`}
                        onClick={() =>
                          onModifier(actualite)
                        }
                        title="Modifier"
                      >
                        ✎
                      </button>

                      <button
                        className={`${styles.actionButton} ${styles.deleteButton}`}
                        onClick={() =>
                          onSupprimer(actualite.id)
                        }
                        title="Supprimer"
                      >
                        🗑
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td
                  colSpan={5}
                  className={styles.empty}
                >
                  Aucune actualité trouvée.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      {/* FOOTER */}
      <div className={styles.footer}>
        <span className={styles.resultCount}>
          {actualitesFiltrees.length} actualité
          {actualitesFiltrees.length > 1 ? "s" : ""}
        </span>

        {totalPages > 1 && (
          <div className={styles.pagination}>
            <button
              disabled={page === 1}
              onClick={() =>
                setPage((ancienne) => ancienne - 1)
              }
              className={styles.pageButton}
            >
              ‹
            </button>

            {Array.from(
              { length: totalPages },
              (_, index) => index + 1
            ).map((numero) => (
              <button
                key={numero}
                onClick={() => setPage(numero)}
                className={`${styles.pageButton} ${
                  page === numero
                    ? styles.activePage
                    : ""
                }`}
              >
                {numero}
              </button>
            ))}

            <button
              disabled={page === totalPages}
              onClick={() =>
                setPage((ancienne) => ancienne + 1)
              }
              className={styles.pageButton}
            >
              ›
            </button>
          </div>
        )}
      </div>
    </section>
  );
}


