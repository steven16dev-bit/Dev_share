3. Upload de plusieurs fichiers

Dans ton API frontend :

export async function uploadFiles(
  folderId: number,
  files: File[]
) {
  const formData = new FormData()

  for (const file of files) {
    formData.append("files", file)
  }

  const response = await fetch(
    `${API}/files/upload/${folderId}`,
    {
      method: "POST",
      body: formData
    }
  )

  if (!response.ok) {
    throw new Error(
      "Erreur lors de l'upload des fichiers."
    )
  }

  return response.json()
}

⚠️ Le nom doit être files dans les deux côtés :

Frontend                  Backend
────────────────────────────────────────
formData.append("files")  List<IFormFile> files


