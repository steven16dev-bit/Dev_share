Oui. Pour ton portail, je te conseille de faire en sorte que Next.js ne connaisse pas directement le stockage des fichiers. Les documents viennent de l’API .NET, qui elle-même gère Oracle et le stockage physique.

Architecture

Next.js
                       │
                       │ GET
                       ▼
              .NET Core Web API
                       │
             ┌─────────┴─────────┐
             ▼                   ▼
         Oracle 19c          Stockage fichiers
         métadonnées          PDF / DOCX / ...

Par exemple :

GET /api/documents
GET /api/documents/10
GET /api/documents/10/download
GET /api/documents/10/preview

1. API retourne les métadonnées

Par exemple :

[
  {
    "id": 10,
    "name": "Rapport annuel 2025.pdf",
    "type": "PDF",
    "year": 2025,
    "folderId": 3,
    "folderName": "Rapports",
    "size": 2456789
  },
  {
    "id": 11,
    "name": "Note de service.pdf",
    "type": "PDF",
    "year": 2026,
    "folderId": 4,
    "folderName": "Notes",
    "size": 1254789
  }
]

Je recommande de ne pas retourner le fichier PDF dans cette première requête.


---

2. Next.js récupère les documents

services/documentService.js

import { apiFetch } from "./api";

export async function getDocuments() {
    return apiFetch("/documents");
}

export async function getDocument(id) {
    return apiFetch(`/documents/${id}`);
}

Puis dans ta page :

"use client";

import { useEffect, useState } from "react";
import { getDocuments } from "@/services/documentService";

export default function DocumentsPage() {
    const [documents, setDocuments] = useState([]);
    const [loading, setLoading] = useState(true);

    useEffect(() => {
        async function loadDocuments() {
            try {
                const data = await getDocuments();
                setDocuments(data);
            } catch (error) {
                console.error(error);
            } finally {
                setLoading(false);
            }
        }

        loadDocuments();
    }, []);

    if (loading) {
        return <p>Chargement...</p>;
    }

    return (
        <div>
            {documents.map((doc) => (
                <div key={doc.id}>
                    {doc.name}
                </div>
            ))}
        </div>
    );
}


