Oui. Si le renommage ne marche pas du tout, il vaut mieux corriger le problème à la source plutôt que modifier encore REPLACE.

Le point suspect dans notre code précédent est GetFolderPhysicalPathAsync() : pour un renommage, il faut calculer l'ancien chemin avant de modifier Oracle, puis faire le UPDATE, puis Directory.Move.

Je te propose de repartir sur une version plus simple et fiable.

1. Remplace entièrement RenameAsync

public async Task RenameAsync(long folderId, string newName)
{
    if (string.IsNullOrWhiteSpace(newName))
        throw new Exception("Le nom du dossier est obligatoire.");

    newName = newName.Trim();

    // =========================================================
    // 1. Connexion Oracle
    // =========================================================

    await using var connection = _factory.Create();
    await connection.OpenAsync();

    // =========================================================
    // 2. Récupérer le dossier
    // =========================================================

    string oldName;
    long? parentId;

    const string selectSql = """
        SELECT NAME, PARENT_ID
        FROM FILE_FOLDERS
        WHERE ID = :id
        """;

    await using (var command =
        new OracleCommand(selectSql, connection))
    {
        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = folderId;

        await using var reader =
            await command.ExecuteReaderAsync();

        if (!await reader.ReadAsync())
            throw new Exception("Dossier introuvable.");

        oldName = reader.GetString(0);

        parentId = reader.IsDBNull(1)
            ? null
            : reader.GetInt64(1);
    }

    // =========================================================
    // 3. Vérifier le nouveau nom
    // =========================================================

    const string duplicateSql = """
        SELECT COUNT(*)
        FROM FILE_FOLDERS
        WHERE NAME = :name
        AND (
            PARENT_ID = :parentId
            OR (PARENT_ID IS NULL AND :parentId IS NULL)
        )
        AND ID <> :id
        """;

    await using (var command =
        new OracleCommand(duplicateSql, connection))
    {
        command.Parameters.Add(
            "name",
            OracleDbType.Varchar2
        ).Value = newName;

        command.Parameters.Add(
            "parentId",
            OracleDbType.Int64
        ).Value =
            parentId.HasValue
                ? parentId.Value
                : DBNull.Value;

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = folderId;

        var count =
            Convert.ToInt32(
                await command.ExecuteScalarAsync()
            );

        if (count > 0)
            throw new Exception(
                $"Un dossier '{newName}' existe déjà."
            );
    }

    // =========================================================
    // 4. CHEMIN PHYSIQUE ACTUEL
    // =========================================================

    var oldPath =
        await GetFolderPhysicalPathAsync(folderId);

    if (!Directory.Exists(oldPath))
    {
        throw new DirectoryNotFoundException(
            $"Le dossier physique n'existe pas : {oldPath}"
        );
    }

    // =========================================================
    // 5. NOUVEAU CHEMIN
    // =========================================================

    var parentPath =
        Directory.GetParent(oldPath)?.FullName;

    if (string.IsNullOrEmpty(parentPath))
        throw new Exception(
            "Impossible de déterminer le dossier parent."
        );

    var newPath =
        Path.Combine(
            parentPath,
            SanitizeFolderName(newName)
        );

    // =========================================================
    // 6. Vérifier que le nouveau dossier n'existe pas
    // =========================================================

    if (Directory.Exists(newPath))
    {
        throw new Exception(
            $"Le dossier physique '{newName}' existe déjà."
        );
    }

    // =========================================================
    // 7. RENOMMER PHYSIQUEMENT
    // =========================================================

    try
    {
        Directory.Move(oldPath, newPath);
    }
    catch (Exception ex)
    {
        throw new Exception(
            $"Impossible de renommer le dossier physiquement.\n" +
            $"Ancien chemin : {oldPath}\n" +
            $"Nouveau chemin : {newPath}\n" +
            $"Erreur : {ex.Message}",
            ex
        );
    }

    // =========================================================
    // 8. Transaction Oracle
    // =========================================================

    await using var transaction =
        (OracleTransaction)await connection.BeginTransactionAsync();

    try
    {
        // -----------------------------------------------------
        // Modifier le nom du dossier
        // -----------------------------------------------------

        const string updateFolderSql = """
            UPDATE FILE_FOLDERS
            SET NAME = :name,
                UPDATED_AT = SYSTIMESTAMP
            WHERE ID = :id
            """;

        await using (var command =
            new OracleCommand(
                updateFolderSql,
                connection))
        {
            command.Transaction = transaction;

            command.Parameters.Add(
                "name",
                OracleDbType.Varchar2
            ).Value = newName;

            command.Parameters.Add(
                "id",
                OracleDbType.Int64
            ).Value = folderId;

            await command.ExecuteNonQueryAsync();
        }

        // -----------------------------------------------------
        // Modifier les chemins des fichiers
        // -----------------------------------------------------

        const string updateFilesSql = """
            UPDATE FILE_DOCUMENTS
            SET FILE_PATH =
                REPLACE(
                    FILE_PATH,
                    :oldPath,
                    :newPath
                ),
                UPDATED_AT = SYSTIMESTAMP
            WHERE FILE_PATH LIKE :oldPathLike
            """;

        await using (var command =
            new OracleCommand(
                updateFilesSql,
                connection))
        {
            command.Transaction = transaction;

            command.Parameters.Add(
                "oldPath",
                OracleDbType.Varchar2
            ).Value = oldPath;

            command.Parameters.Add(
                "newPath",
                OracleDbType.Varchar2
            ).Value = newPath;

            command.Parameters.Add(
                "oldPathLike",
                OracleDbType.Varchar2
            ).Value = oldPath + "%";

            await command.ExecuteNonQueryAsync();
        }

        // -----------------------------------------------------
        // Valider Oracle
        // -----------------------------------------------------

        await transaction.CommitAsync();
    }
    catch
    {
        // Oracle a échoué :
        // on remet le dossier physique à son ancien nom

        try
        {
            if (Directory.Exists(newPath) &&
                !Directory.Exists(oldPath))
            {
                Directory.Move(newPath, oldPath);
            }
        }
        catch
        {
            // Ne pas masquer l'erreur Oracle
        }

        try
        {
            await transaction.RollbackAsync();
        }
        catch
        {
        }

        throw;
    }
}

2. Très important : vérifie ton GetFolderPhysicalPathAsync

Utilise exactement ceci :

private async Task<string> GetFolderPhysicalPathAsync(long folderId)
{
    var folders =
        new List<(string Name, long? ParentId)>();

    await using var connection =
        _factory.Create();

    await connection.OpenAsync();

    const string sql = """
        SELECT NAME, PARENT_ID
        FROM FILE_FOLDERS
        START WITH ID = :folderId
        CONNECT BY PRIOR PARENT_ID = ID
        """;

    await using var command =
        new OracleCommand(sql, connection);

    command.Parameters.Add(
        "folderId",
        OracleDbType.Int64
    ).Value = folderId;

    await using var reader =
        await command.ExecuteReaderAsync();

    while (await reader.ReadAsync())
    {
        folders.Add(
            (
                reader.GetString(0),
                reader.IsDBNull(1)
                    ? null
                    : reader.GetInt64(1)
            )
        );
    }

    if (folders.Count == 0)
        throw new Exception("Dossier introuvable.");

    folders.Reverse();

    var path = StorageRoot;

    foreach (var folder in folders)
    {
        path = Path.Combine(
            path,
            SanitizeFolderName(folder.Name)
        );
    }

    return path;
}

3. Et le StorageRoot

Dans FolderService :

private string StorageRoot
{
    get
    {
        var path = Path.Combine(
            _environment.ContentRootPath,
            "Storage"
        );

        Directory.CreateDirectory(path);

        return path;
    }
}

4. Pourquoi cette version devrait fonctionner avec

Dossier 1
└── Dossier 2
    └── Dossier 3
        └── fichier.txt

Si tu renommes :

Dossier 1 → Dossier ABC

Windows fait directement :

Storage/
└── Dossier ABC/
    └── Dossier 2/
        └── Dossier 3/
            └── fichier.txt

Puis Oracle fait :

Dossier 1
       ↓
Dossier ABC

et :

FILE_PATH

passe par exemple de :

C:\...\Storage\Dossier 1\Dossier 2\Dossier 3\fichier.txt

à :

C:\...\Storage\Dossier ABC\Dossier 2\Dossier 3\fichier.txt

Si ça échoue encore

Avec cette version, l'erreur indiquera maintenant exactement à quelle étape ça bloque.

En particulier, si tu obtiens :

Impossible de renommer le dossier physiquement.
Ancien chemin : ...
Nouveau chemin : ...
Erreur : ...

envoie-moi le message Erreur : ... exact. C'est lui qui permettra d'identifier immédiatement si le problème vient du chemin, d'un fichier verrouillé, des droits Windows ou de la construction de l'arborescence.