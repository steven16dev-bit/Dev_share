Services/FolderService.cs

using DocumentManager.Api.Data;
using DocumentManager.Api.DTOs;
using DocumentManager.Api.Models;
using Oracle.ManagedDataAccess.Client;
using System.Data;

namespace DocumentManager.Api.Services;

public class FolderService
{
    private readonly OracleConnectionFactory _factory;

    public FolderService(OracleConnectionFactory factory)
    {
        _factory = factory;
    }

    public async Task<List<Folder>> GetAllAsync()
    {
        var result = new List<Folder>();

        await using var connection = _factory.Create();

        await connection.OpenAsync();

        const string sql = """
            SELECT
                ID,
                NAME,
                PARENT_ID,
                CREATED_AT,
                UPDATED_AT
            FROM FILE_FOLDERS
            ORDER BY NAME
            """;

        await using var command =
            new OracleCommand(sql, connection);

        await using var reader =
            await command.ExecuteReaderAsync();

        while (await reader.ReadAsync())
        {
            result.Add(new Folder
            {
                Id = reader.GetInt64(0),
                Name = reader.GetString(1),
                ParentId = reader.IsDBNull(2)
                    ? null
                    : reader.GetInt64(2),

                CreatedAt = reader.GetDateTime(3),
                UpdatedAt = reader.GetDateTime(4)
            });
        }

        return result;
    }

    public async Task<Folder> CreateAsync(
        CreateFolderDto dto)
    {
        await using var connection = _factory.Create();

        await connection.OpenAsync();

        const string sql = """
            INSERT INTO FILE_FOLDERS
            (
                NAME,
                PARENT_ID
            )
            VALUES
            (
                :name,
                :parentId
            )
            RETURNING ID INTO :id
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "name",
            OracleDbType.Varchar2
        ).Value = dto.Name;

        command.Parameters.Add(
            "parentId",
            OracleDbType.Int64
        ).Value = dto.ParentId ?? (object)DBNull.Value;

        var idParameter =
            new OracleParameter(
                "id",
                OracleDbType.Int64
            )
            {
                Direction =
                    ParameterDirection.Output
            };

        command.Parameters.Add(idParameter);

        await command.ExecuteNonQueryAsync();

        return new Folder
        {
            Id = Convert.ToInt64(idParameter.Value.ToString()),
            Name = dto.Name,
            ParentId = dto.ParentId,
            CreatedAt = DateTime.Now,
            UpdatedAt = DateTime.Now
        };
    }

    public async Task RenameAsync(
        long id,
        string name)
    {
        await using var connection = _factory.Create();

        await connection.OpenAsync();

        const string sql = """
            UPDATE FILE_FOLDERS
            SET
                NAME = :name,
                UPDATED_AT = SYSTIMESTAMP
            WHERE ID = :id
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "name",
            OracleDbType.Varchar2
        ).Value = name;

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = id;

        await command.ExecuteNonQueryAsync();
    }

    public async Task MoveAsync(
        long id,
        long? newParentId)
    {
        await using var connection = _factory.Create();

        await connection.OpenAsync();

        const string sql = """
            UPDATE FILE_FOLDERS
            SET
                PARENT_ID = :parentId,
                UPDATED_AT = SYSTIMESTAMP
            WHERE ID = :id
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "parentId",
            OracleDbType.Int64
        ).Value =
            newParentId ?? (object)DBNull.Value;

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = id;

        await command.ExecuteNonQueryAsync();
    }

    public async Task DeleteAsync(long id)
    {
        await using var connection = _factory.Create();

        await connection.OpenAsync();

        using var transaction =
            connection.BeginTransaction();

        try
        {
            const string deleteFiles = """
                DELETE FROM FILE_DOCUMENTS
                WHERE FOLDER_ID = :id
                """;

            await using var fileCommand =
                new OracleCommand(
                    deleteFiles,
                    connection
                );

            fileCommand.Parameters.Add(
                "id",
                OracleDbType.Int64
            ).Value = id;

            fileCommand.Transaction = transaction;

            await fileCommand.ExecuteNonQueryAsync();

            const string deleteFolder = """
                DELETE FROM FILE_FOLDERS
                WHERE ID = :id
                """;

            await using var folderCommand =
                new OracleCommand(
                    deleteFolder,
                    connection
                );

            folderCommand.Parameters.Add(
                "id",
                OracleDbType.Int64
            ).Value = id;

            folderCommand.Transaction = transaction;

            await folderCommand.ExecuteNonQueryAsync();

            await transaction.CommitAsync();
        }
        catch
        {
            await transaction.RollbackAsync();
            throw;
        }
    }
}


