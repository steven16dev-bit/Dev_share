4. Upload avec le même nom

Remplace ton ancienne méthode UploadAsync par :

public async Task UploadAsync(
    long folderId,
    IFormFile file)
{
    if (file == null || file.Length == 0)
        throw new Exception(
            "Fichier vide."
        );

    // Vérifier le nom
    var originalFileName =
        Path.GetFileName(file.FileName);

    if (string.IsNullOrWhiteSpace(
        originalFileName))
    {
        throw new Exception(
            "Nom de fichier invalide."
        );
    }

    // Construire le chemin physique
    var folderPath =
        await GetFolderPhysicalPathAsync(
            folderId
        );

    // Créer toute l'arborescence
    Directory.CreateDirectory(
        folderPath
    );

    // Même nom que le fichier original
    var physicalPath =
        Path.Combine(
            folderPath,
            originalFileName
        );

    // Vérification physique
    if (System.IO.File.Exists(
        physicalPath))
    {
        throw new FileAlreadyExistsException(
            originalFileName
        );
    }

    // Vérification Oracle
    if (await FileExistsInDatabaseAsync(
        folderId,
        originalFileName))
    {
        throw new FileAlreadyExistsException(
            originalFileName
        );
    }

    try
    {
        // Écriture du fichier
        await using (
            var stream =
                new FileStream(
                    physicalPath,
                    FileMode.CreateNew,
                    FileAccess.Write,
                    FileShare.None
                ))
        {
            await file.CopyToAsync(stream);
        }

        await using var connection =
            _factory.Create();

        await connection.OpenAsync();

        const string sql = """
            INSERT INTO FILE_DOCUMENTS
            (
                FOLDER_ID,
                FILE_NAME,
                STORED_NAME,
                FILE_PATH,
                CONTENT_TYPE,
                FILE_SIZE
            )
            VALUES
            (
                :folderId,
                :fileName,
                :storedName,
                :filePath,
                :contentType,
                :fileSize
            )
            """;

        await using var command =
            new OracleCommand(
                sql,
                connection
            );

        command.Parameters.Add(
            "folderId",
            OracleDbType.Int64
        ).Value = folderId;

        command.Parameters.Add(
            "fileName",
            OracleDbType.Varchar2
        ).Value = originalFileName;

        // Maintenant STORED_NAME = nom original
        command.Parameters.Add(
            "storedName",
            OracleDbType.Varchar2
        ).Value = originalFileName;

        command.Parameters.Add(
            "filePath",
            OracleDbType.Varchar2
        ).Value = physicalPath;

        command.Parameters.Add(
            "contentType",
            OracleDbType.Varchar2
        ).Value =
            file.ContentType ??
            "application/octet-stream";

        command.Parameters.Add(
            "fileSize",
            OracleDbType.Int64
        ).Value = file.Length;

        await command.ExecuteNonQueryAsync();
    }
    catch
    {
        // Si Oracle échoue après la création physique,
        // on supprime le fichier créé.
        if (System.IO.File.Exists(
            physicalPath))
        {
            System.IO.File.Delete(
                physicalPath
            );
        }

        throw;
    }
}


