// ========================================
// 1. Liste des articles
// ========================================

const articles = [

    {
        id: 1,

        title: "Nouveau projet stratégique",

        category: "Entreprise",

        date: "31 août 2026",

        image: "images/news-01.jpg",

        content: `
            <p>
                L'entreprise annonce le lancement
                d'un nouveau projet stratégique.
            </p>

            <p>
                Ce projet vise à améliorer les
                performances et la qualité des services.
            </p>
        `
    },

    {
        id: 2,

        title: "Nouvelle procédure interne",

        category: "Information",

        date: "28 août 2026",

        image: "images/news-02.jpg",

        content: `
            <p>
                Une nouvelle procédure interne
                entre en vigueur.
            </p>
        `
    }

];


// ========================================
// 2. Récupérer l'ID depuis l'URL
// ========================================

const params =
    new URLSearchParams(
        window.location.search
    );

const articleId =
    Number(
        params.get("id")
    );


// ========================================
// 3. Rechercher l'article
// ========================================

const article =
    articles.find(
        item => item.id === articleId
    );


// ========================================
// 4. Afficher l'article
// ========================================

if (article) {

    document.getElementById(
        "articleTitle"
    ).textContent =
        article.title;


    document.getElementById(
        "articleDate"
    ).textContent =
        article.date;


    document.getElementById(
        "articleImage"
    ).src =
        article.image;


    document.getElementById(
        "articleImage"
    ).alt =
        article.title;


    document.getElementById(
        "articleContent"
    ).innerHTML =
        article.content;

}

