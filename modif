3. Surtout : nouveau responsive mobile

C'est cette partie qui va régler le problème.

Remplacez votre ancien @media(max-width: 800px) par :

/* =========================================
   TABLET
========================================= */

@media (max-width: 1100px) {

    .brand {
        width: auto;
    }

    .brand-text {
        display: none;
    }

    .main-nav {
        justify-content: flex-start;
    }

    .content-grid {
        grid-template-columns: 1fr;
    }

    .news-cards {
        grid-template-columns:
            repeat(2, 1fr);
    }
}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 800px) {

    .topbar {

        height: 64px;

        padding: 0 14px;

        gap: 8px;
    }


    /* Logo */

    .brand {

        width: auto;

        flex: 1;
    }

    .brand img {

        width: 40px;
        height: 40px;

        margin-right: 0;
    }

    .brand-text {
        display: none;
    }


    /* Menu principal */

    .main-nav {
        display: none;
    }


    /* Actions */

    .top-actions {

        gap: 4px;
    }


    .icon-button {
        display: none;
    }


    /* Profil */

    .profile span {
        display: none;
    }

    .profile > i {
        display: none;
    }


    .profile img {

        width: 38px;
        height: 38px;
    }


    /* =====================================
       APPLICATIONS MOBILE
    ===================================== */

    .apps-panel {

        position: fixed;

        top: 72px;

        left: 10px;
        right: 10px;

        width: auto;

        max-width: 390px;

        margin-left: auto;
        margin-right: auto;

        padding: 20px;

        max-height:
            calc(100vh - 90px);

        overflow-y: auto;

        border-radius: 16px;

        box-shadow:
            0 15px 45px rgba(0, 0, 0, .20);
    }


    .apps-panel::before {

        display: none;
    }


    .apps-grid {

        grid-template-columns:
            repeat(4, 1fr);

        gap: 20px 8px;
    }


    .app-icon {

        width: 44px;
        height: 44px;

        font-size: 18px;
    }


    .apps-grid a {

        font-size: 12px;
    }


    /* =====================================
       PROFILE MOBILE
    ===================================== */

    .profile-menu {

        position: fixed;

        top: 72px;

        left: 15px;
        right: 15px;

        width: auto;

        max-width: 350px;

        margin-left: auto;

        padding: 10px;

        border-radius: 14px;

        box-shadow:
            0 15px 45px rgba(0, 0, 0, .20);
    }


    /* Page */

    .page {

        width: calc(100% - 30px);

        padding-top: 30px;
    }


    /* Dashboard */

    .dashboard-grid {

        grid-template-columns: 1fr;
    }


    .content-grid {

        grid-template-columns: 1fr;
    }


    /* News */

    .news-cards {

        grid-template-columns: 1fr;
    }


    .all-news-grid {

        grid-template-columns: 1fr;
    }


    /* Documents */

    .documents-layout {

        grid-template-columns: 1fr;
    }


    .folder-sidebar {

        display: none;
    }


    /* Toolbar */

    .document-toolbar,
    .news-toolbar {

        flex-direction: column;
    }


    select {

        width: 100%;
    }

}


