Oui. Le problème vient de buildFolderTree() : à chaque clic sur un dossier, l'arborescence est reconstruite, donc les éléments .children perdent leur état open.

Le mieux est de mémoriser les dossiers ouverts.

1. Ajoutez cette variable

Placez-la avec vos autres variables globales :

let currentFolder = "all";

let currentPage = 1;

const pageSize = 6;

let currentDocument = null;

let zoom = 100;

// Mémorise les dossiers ouverts
const openFolders = new Set();


---

2. Remplacez createFolderElement() par cette version

function createFolderElement(folder) {

    const li = document.createElement("li");

    li.className = "tree-item";


    const row = document.createElement("div");

    row.className = "tree-row";


    if (folder.id === currentFolder) {
        row.classList.add("active");
    }


    const children = folders.filter(
        f => f.parent === folder.id
    );


    /* ==============================
       FLÈCHE
    ============================== */

    const arrow = document.createElement("span");

    arrow.className = "folder-arrow";

    arrow.innerHTML = children.length ? "▶" : "";


    /* ==============================
       ICÔNE
    ============================== */

    const icon = document.createElement("span");

    icon.className = "folder-icon";

    icon.innerHTML = folder.icon;


    /* ==============================
       NOM
    ============================== */

    const name = document.createElement("span");

    name.className = "folder-name";

    name.textContent = folder.name;


    /* ==============================
       COMPTEUR
    ============================== */

    const count = document.createElement("span");

    count.className = "file-count";

    count.textContent = getFolderCount(folder.id);


    row.append(
        arrow,
        icon,
        name,
        count
    );


    /*
       Clic sur le nom du dossier
       = sélectionner le dossier
    */

    row.onclick = function(e) {

        e.stopPropagation();

        selectFolder(folder.id);

    };


    li.appendChild(row);


    /* ==============================
       SOUS-DOSSIERS
    ============================== */

    if (children.length) {

        const childrenContainer =
            document.createElement("div");

        childrenContainer.className = "children";


        /*
           Restaurer l'état du dossier
        */

        if (openFolders.has(folder.id)) {

            childrenContainer.classList.add("open");

            arrow.classList.add("open");

        }


        children.forEach(child => {

            childrenContainer.appendChild(
                createFolderElement(child)
            );

        });


        li.appendChild(childrenContainer);


        /*
           Clic uniquement sur la flèche
           = ouvrir / fermer
        */

        arrow.onclick = function(e) {

            e.stopPropagation();

            if (
                openFolders.has(folder.id)
            ) {

                openFolders.delete(folder.id);

                childrenContainer.classList.remove(
                    "open"
                );

                arrow.classList.remove(
                    "open"
                );

            } else {

                openFolders.add(folder.id);

                childrenContainer.classList.add(
                    "open"
                );

                arrow.classList.add(
                    "open"
                );

            }

        };

    }


    return li;
}


