3. Modifiez également selectFolder()

Utilisez :

function selectFolder(folderId) {

    currentFolder = folderId;

    currentPage = 1;


    /*
       Ouvre automatiquement les parents
       du dossier sélectionné
    */

    openParentFolders(folderId);


    const folder = folders.find(
        f => f.id === folderId
    );


    if (folder) {

        document.getElementById(
            "currentFolderTitle"
        ).textContent = folder.name;


        document.getElementById(
            "currentFolderDescription"
        ).textContent =
            getFolderCount(folderId)
            + " document(s) disponible(s)";

    }


    /*
       Reconstruit l'arbre mais restaure
       automatiquement les dossiers ouverts
    */

    buildFolderTree();

    renderDocuments();

}


