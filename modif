/* =========================================================
   VARIABLES
========================================================= */

let currentFolder = "all";

let currentPage = 1;

const pageSize = 6;

let currentDocument = null;

let zoom = 100;



/* =========================================================
   CONSTRUIRE L'ARBRE DES DOSSIERS
========================================================= */

function buildFolderTree() {

    const tree = document.getElementById("folderTree");

    tree.innerHTML = "";

    folders
        .filter(folder => folder.parent === null)
        .forEach(folder => {

            tree.appendChild(
                createFolderElement(folder)
            );

        });

}



function createFolderElement(folder) {

    const li = document.createElement("li");

    li.className = "tree-item";


    const row = document.createElement("div");

    row.className = "tree-row";


    if (folder.id === currentFolder) {

        row.classList.add("active");

    }


    const children =
        folders.filter(
            f => f.parent === folder.id
        );


    /* flèche */

    const arrow =
        document.createElement("span");

    arrow.className = "folder-arrow";

    arrow.innerHTML =
        children.length ? "▶" : "";


    /* icône */

    const icon =
        document.createElement("span");

    icon.className = "folder-icon";

    icon.innerHTML = folder.icon;


    /* nom */

    const name =
        document.createElement("span");

    name.className = "folder-name";

    name.textContent = folder.name;


    /* compteur */

    const count =
        document.createElement("span");

    count.className = "file-count";

    count.textContent =
        getFolderCount(folder.id);


    row.append(
        arrow,
        icon,
        name,
        count
    );


    row.onclick = function(e) {

        e.stopPropagation();

        selectFolder(folder.id);

    };


    li.appendChild(row);


    /* enfants */

    if (children.length) {

        const childrenContainer =
            document.createElement("div");

        childrenContainer.className =
            "children";


        children.forEach(child => {

            childrenContainer.appendChild(
                createFolderElement(child)
            );

        });


        li.appendChild(childrenContainer);


        arrow.onclick = function(e) {

            e.stopPropagation();

            childrenContainer.classList.toggle(
                "open"
            );

            arrow.classList.toggle(
                "open"
            );

        };

    }


    return li;

}



/* =========================================================
   COMPTEUR DES DOSSIERS
========================================================= */

function getFolderCount(folderId) {

    const childFolders =
        folders
        .filter(
            f => f.parent === folderId
        )
        .map(
            f => f.id
        );


    let ids = [
        folderId,
        ...getAllChildren(folderId)
    ];


    return documents.filter(
        document =>
            ids.includes(document.folder)
    ).length;

}



function getAllChildren(folderId) {

    let result = [];


    const children =
        folders.filter(
            f => f.parent === folderId
        );


    children.forEach(child => {

        result.push(child.id);

        result.push(
            ...getAllChildren(child.id)
        );

    });


    return result;

}



/* =========================================================
   SELECTION DOSSIER
========================================================= */

function selectFolder(folderId) {

    currentFolder = folderId;

    currentPage = 1;

    const folder =
        folders.find(
            f => f.id === folderId
        );


    document.getElementById(
        "currentFolderTitle"
    ).textContent =
        folder.name;


    document.getElementById(
        "currentFolderDescription"
    ).textContent =
        getFolderCount(folderId)
        + " document(s) disponible(s)";


    buildFolderTree();

    renderDocuments();

}



/* =========================================================
   DOCUMENTS DU DOSSIER
========================================================= */

function getCurrentDocuments() {

    let result = [...documents];


    if (currentFolder !== "all") {

        const foldersIncluded = [

            currentFolder,

            ...getAllChildren(currentFolder)

        ];


        result =
            result.filter(
                document =>
                    foldersIncluded.includes(
                        document.folder
                    )
            );

    }


    return result;

}



/* =========================================================
   FILTRES
========================================================= */

function applyFilters() {

    let result =
        getCurrentDocuments();


    const search =
        document.getElementById(
            "searchInput"
        ).value
        .toLowerCase();


    const type =
        document.getElementById(
            "typeFilter"
        ).value;


    const year =
        document.getElementById(
            "yearFilter"
        ).value;


    const sort =
        document.getElementById(
            "sortFilter"
        ).value;


    if (search) {

        result =
            result.filter(
                doc =>
                    doc.name
                    .toLowerCase()
                    .includes(search)
            );

    }


    if (type) {

        result =
            result.filter(
                doc =>
                    type === "pdf"
            );

    }


    if (year) {

        result =
            result.filter(
                doc =>
                    String(doc.year) === year
            );

    }


    /* TRI */

    result.sort(
        (a, b) => {

            if (sort === "date-desc") {

                return new Date(b.date)
                    - new Date(a.date);

            }

            if (sort === "date-asc") {

                return new Date(a.date)
                    - new Date(b.date);

            }

            if (sort === "name-asc") {

                return a.name
                    .localeCompare(b.name);

            }

            if (sort === "name-desc") {

                return b.name
                    .localeCompare(a.name);

            }

        }
    );


    return result;

}



/* =========================================================
   AFFICHAGE DOCUMENTS
========================================================= */

function renderDocuments() {

    const container =
        document.getElementById(
            "documentsContainer"
        );


    container.innerHTML = "";


    const filtered =
        applyFilters();


    document.getElementById(
        "resultCount"
    ).textContent =
        filtered.length
        + " document(s)";


    const totalPages =
        Math.ceil(
            filtered.length / pageSize
        );


    if (currentPage > totalPages) {

        currentPage =
            Math.max(totalPages, 1);

    }


    const start =
        (currentPage - 1)
        * pageSize;


    const pageDocuments =
        filtered.slice(
            start,
            start + pageSize
        );


    if (!pageDocuments.length) {

        container.innerHTML = `
            <div class="empty">
                <div style="font-size:40px">
                    📄
                </div>

                <br>

                Aucun document trouvé.
            </div>
        `;

        renderPagination(0);

        return;

    }


    pageDocuments.forEach(
        document => {

            const card =
                document.createElement(
                    "div"
                );

            card.className =
                "document-card";


            card.innerHTML = `

                <div
                    class="pdf-cover"
                    onclick="openViewer(${document.id})"
                >

                    <span class="pdf-label">
                        PDF
                    </span>

                    <iframe
                        src="${document.url}#page=1&toolbar=0&navpanes=0"
                    ></iframe>

                </div>


                <div class="card-body">

                    <div
                        class="file-name"
                        title="${document.name}"
                    >
                        ${document.name}
                    </div>


                    <div class="file-meta">

                        <span>
                            ${document.pages} pages
                        </span>

                        <span>
                            •
                        </span>

                        <span>
                            ${document.size}
                        </span>

                    </div>


                    <div class="card-actions">

                        <button
                            class="btn primary"
                            onclick="openViewer(${document.id})"
                        >
                            👁 Voir
                        </button>


                        <button
                            class="btn"
                            onclick="downloadDocument(${document.id})"
                        >
                            ↓ Télécharger
                        </button>

                    </div>

                </div>

            `;


            container.appendChild(card);

        }
    );


    renderPagination(totalPages);

}



/* =========================================================
   PAGINATION
========================================================= */

function renderPagination(totalPages) {

    const pagination =
        document.getElementById(
            "pagination"
        );


    pagination.innerHTML = "";


    if (totalPages <= 1) {

        return;

    }


    const previous =
        createPageButton(
            "‹",
            currentPage - 1
        );


    previous.disabled =
        currentPage === 1;


    pagination.appendChild(previous);


    for (
        let i = 1;
        i <= totalPages;
        i++
    ) {

        const button =
            createPageButton(
                i,
                i
            );


        if (i === currentPage) {

            button.classList.add(
                "active"
            );

        }


        pagination.appendChild(button);

    }


    const next =
        createPageButton(
            "›",
            currentPage + 1
        );


    next.disabled =
        currentPage === totalPages;


    pagination.appendChild(next);

}



function createPageButton(
    text,
    page
) {

    const button =
        document.createElement(
            "button"
        );

    button.className =
        "page-btn";

    button.textContent =
        text;


    button.onclick = function() {

        if (page < 1) return;

        currentPage = page;

        renderDocuments();

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });

    };


    return button;

}



/* =========================================================
   PDF VIEWER
========================================================= */

function openViewer(id) {

    const document =
        documents.find(
            doc => doc.id === id
        );


    if (!document) return;


    currentDocument =
        document;


    document.getElementById(
        "viewerTitle"
    ).textContent =
        "📄 " + document.name;


    document.getElementById(
        "pdfViewer"
    ).src =
        document.url
        + "#page=1&toolbar=1&navpanes=1";


    document.getElementById(
        "pageNumber"
    ).value = 1;


    zoom = 100;


    document.getElementById(
        "zoomValue"
    ).textContent =
        zoom + "%";

}



/* =========================================================
   FERMER VIEWER
========================================================= */

function closeViewer() {

    document.getElementById(
        "pdfViewer"
    ).src = "";


    currentDocument = null;


    document.getElementById(
        "viewerTitle"
    ).textContent =
        "📄 Aucun document sélectionné";

}



/* =========================================================
   DOWNLOAD
========================================================= */

function downloadDocument(id) {

    const doc =
        documents.find(
            d => d.id === id
        );


    if (!doc) return;


    const link =
        document.createElement("a");


    link.href =
        doc.url;


    link.download =
        doc.name;


    link.target =
        "_blank";


    link.click();

}



function downloadCurrent() {

    if (currentDocument) {

        downloadDocument(
            currentDocument.id
        );

    }

}



/* =========================================================
   ZOOM
========================================================= */

function zoomIn() {

    zoom += 10;

    document.getElementById(
        "zoomValue"
    ).textContent =
        zoom + "%";

}


function zoomOut() {

    zoom =
        Math.max(
            50,
            zoom - 10
        );

    document.getElementById(
        "zoomValue"
    ).textContent =
        zoom + "%";

}



/* =========================================================
   PAGE PDF
========================================================= */

function nextPage() {

    if (!currentDocument) return;


    let page =
        parseInt(
            document.getElementById(
                "pageNumber"
            ).value
        );


    page =
        Math.min(
            currentDocument.pages,
            page + 1
        );


    setPdfPage(page);

}



function previousPage() {

    if (!currentDocument) return;


    let page =
        parseInt(
            document.getElementById(
                "pageNumber"
            ).value
        );


    page =
        Math.max(
            1,
            page - 1
        );


    setPdfPage(page);

}



function setPdfPage(page) {

    document.getElementById(
        "pageNumber"
    ).value =
        page;


    document.getElementById(
        "pdfViewer"
    ).src =
        currentDocument.url
        + "#page="
        + page
        + "&toolbar=1&navpanes=1";

}



/* =========================================================
   FULLSCREEN
========================================================= */

function fullscreenViewer() {

    const viewer =
        document.querySelector(
            ".viewer"
        );


    if (
        document.fullscreenElement
    ) {

        document.exitFullscreen();

    } else {

        viewer.requestFullscreen();

    }

}



/* =========================================================
   ANNÉES
========================================================= */

function buildYears() {

    const select =
        document.getElementById(
            "yearFilter"
        );


    const years =
        [...new Set(
            documents.map(
                doc => doc.year
            )
        )].sort(
            (a,b) => b-a
        );


    years.forEach(year => {

        const option =
            document.createElement(
                "option"
            );

        option.value =
            year;

        option.textContent =
            year;

        select.appendChild(option);

    });

}



