3. FileService.cs

Remplace ta méthode actuelle

Si tu as :

public async Task<List<DocumentFile>> GetByFolderAsync(
    long folderId)

remplace-la par :

public async Task<PagedResult<DocumentFile>> GetByFolderAsync(
    long folderId,
    int page,
    int pageSize)
{
    await using var connection = _factory.Create();

    await connection.OpenAsync();

    // =====================================================
    // 1. Nombre total de fichiers
    // =====================================================

    long totalItems;

    const string countSql = """
        SELECT COUNT(*)
        FROM FILE_DOCUMENTS
        WHERE FOLDER_ID = :folderId
        """;

    await using (var countCommand =
        new OracleCommand(countSql, connection))
    {
        countCommand.Parameters.Add(
            "folderId",
            OracleDbType.Int64
        ).Value = folderId;

        totalItems =
            Convert.ToInt64(
                await countCommand.ExecuteScalarAsync()
            );
    }

    // =====================================================
    // 2. Calcul pagination
    // =====================================================

    var totalPages =
        totalItems == 0
            ? 0
            : (int)Math.Ceiling(
                (double)totalItems / pageSize
            );

    var offset =
        (page - 1) * pageSize;

    // =====================================================
    // 3. Récupérer uniquement la page demandée
    // =====================================================

    const string sql = """
        SELECT
            ID,
            FOLDER_ID,
            FILE_NAME,
            STORED_NAME,
            FILE_PATH,
            CONTENT_TYPE,
            FILE_SIZE,
            CREATED_AT,
            UPDATED_AT
        FROM FILE_DOCUMENTS
        WHERE FOLDER_ID = :folderId
        ORDER BY FILE_NAME
        OFFSET :offset ROWS
        FETCH NEXT :pageSize ROWS ONLY
        """;

    var items =
        new List<DocumentFile>();

    await using (var command =
        new OracleCommand(sql, connection))
    {
        command.Parameters.Add(
            "folderId",
            OracleDbType.Int64
        ).Value = folderId;

        command.Parameters.Add(
            "offset",
            OracleDbType.Int32
        ).Value = offset;

        command.Parameters.Add(
            "pageSize",
            OracleDbType.Int32
        ).Value = pageSize;

        await using var reader =
            await command.ExecuteReaderAsync();

        while (await reader.ReadAsync())
        {
            items.Add(new DocumentFile
            {
                Id = reader.GetInt64(0),

                FolderId = reader.GetInt64(1),

                FileName = reader.GetString(2),

                StoredName = reader.GetString(3),

                FilePath = reader.GetString(4),

                ContentType =
                    reader.IsDBNull(5)
                        ? null
                        : reader.GetString(5),

                FileSize =
                    reader.IsDBNull(6)
                        ? 0
                        : reader.GetInt64(6),

                CreatedAt =
                    reader.GetDateTime(7),

                UpdatedAt =
                    reader.GetDateTime(8)
            });
        }
    }

    // =====================================================
    // 4. Résultat
    // =====================================================

    return new PagedResult<DocumentFile>
    {
        Items = items,

        Page = page,

        PageSize = pageSize,

        TotalItems = totalItems,

        TotalPages = totalPages
    };
}

