Oui, je vois le problème. Le clic sur le dossier fonctionne, puisque le compteur change, mais l'affichage des cartes PDF plante ensuite.

La cause principale est dans mon code précédent : j'ai utilisé document comme nom de variable alors que document est aussi l'objet JavaScript du navigateur. Cela provoque une erreur au moment de créer les cartes.

1. Remplacez complètement renderDocuments() par ceci

function renderDocuments() {

    const container = document.getElementById("documentsContainer");

    container.innerHTML = "";

    const filteredDocuments = applyFilters();

    document.getElementById("resultCount").textContent =
        filteredDocuments.length + " document(s)";

    const totalPages = Math.ceil(
        filteredDocuments.length / pageSize
    );

    if (currentPage > totalPages) {
        currentPage = Math.max(totalPages, 1);
    }

    const start = (currentPage - 1) * pageSize;

    const pageDocuments = filteredDocuments.slice(
        start,
        start + pageSize
    );

    if (pageDocuments.length === 0) {

        container.innerHTML = `
            <div class="empty">
                <div style="font-size:40px">📄</div>
                <br>
                Aucun document dans ce dossier.
            </div>
        `;

        renderPagination(0);
        return;
    }

    pageDocuments.forEach(file => {

        const card = document.createElement("div");

        card.className = "document-card";

        card.innerHTML = `
            <div
                class="pdf-cover"
                onclick="openViewer(${file.id})"
            >

                <span class="pdf-label">
                    PDF
                </span>

                <iframe
                    src="${file.url}#page=1&toolbar=0&navpanes=0"
                    title="${file.name}"
                ></iframe>

            </div>

            <div class="card-body">

                <div
                    class="file-name"
                    title="${file.name}"
                >
                    ${file.name}
                </div>

                <div class="file-meta">
                    <span>${file.pages} pages</span>
                    <span>•</span>
                    <span>${file.size}</span>
                </div>

                <div class="card-actions">

                    <button
                        class="btn primary"
                        onclick="openViewer(${file.id})"
                    >
                        👁 Voir
                    </button>

                    <button
                        class="btn"
                        onclick="downloadDocument(${file.id})"
                    >
                        ↓ Télécharger
                    </button>

                </div>

            </div>
        `;

        container.appendChild(card);

    });

    renderPagination(totalPages);
}

2. Remplacez également openViewer()

function openViewer(id) {

    const selectedFile = documents.find(
        file => file.id === id
    );

    if (!selectedFile) return;

    currentDocument = selectedFile;

    document.getElementById("viewerTitle").textContent =
        "📄 " + selectedFile.name;

    document.getElementById("pdfViewer").src =
        selectedFile.url +
        "#page=1&toolbar=1&navpanes=1";

    document.getElementById("pageNumber").value = 1;

    zoom = 100;

    document.getElementById("zoomValue").textContent =
        "100%";
}

