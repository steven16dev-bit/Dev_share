Exactement. La version précédente était principalement une maquette HTML/CSS : certains éléments étaient visuels mais ne faisaient rien, notamment la recherche, les menus déroulants, le lanceur d'applications et le profil.

Pour un portail réellement fonctionnel, je vous conseille d'ajouter un fichier script.js et de rendre les composants interactifs.

Fonctionnalités à activer

Fonction	Comportement

🔍 Recherche	Recherche les actualités/documents affichés
⋮ Applications	Ouvre/ferme le panneau d'applications au clic
👤 Avatar	Ouvre le menu utilisateur
▼ Menus	Ouvre les sous-menus
📁 Dossiers	Ouvre les sous-dossiers
📄 PDF	Ouvre le document dans le navigateur
📰 Actualités	Filtre les articles
📱 Responsive	Menu adapté au mobile


1. Ajouter js/script.js

document.addEventListener("DOMContentLoaded", () => {

    /* =========================================
       APPLICATIONS
    ========================================= */

    const appsButton = document.querySelector(".apps-button");
    const appsPanel = document.querySelector(".apps-panel");

    if (appsButton && appsPanel) {

        appsButton.addEventListener("click", (event) => {
            event.stopPropagation();

            appsPanel.classList.toggle("show");
        });

        appsPanel.addEventListener("click", (event) => {
            event.stopPropagation();
        });
    }


    /* =========================================
       PROFILE MENU
    ========================================= */

    const profile = document.querySelector(".profile");

    if (profile) {

        profile.addEventListener("click", (event) => {

            event.stopPropagation();

            const menu = document.querySelector(".profile-menu");

            if (menu) {
                menu.classList.toggle("show");
            }
        });
    }


    /* =========================================
       CLOSE POPUPS
    ========================================= */

    document.addEventListener("click", () => {

        if (appsPanel) {
            appsPanel.classList.remove("show");
        }

        const profileMenu =
            document.querySelector(".profile-menu");

        if (profileMenu) {
            profileMenu.classList.remove("show");
        }
    });


    /* =========================================
       SEARCH
    ========================================= */

    const searchInputs =
        document.querySelectorAll(".search-box input");


    searchInputs.forEach(input => {

        input.addEventListener("input", () => {

            const search =
                input.value.toLowerCase().trim();


            /*
             * Recherche des cartes d'actualités
             */

            const newsCards =
                document.querySelectorAll(
                    ".news-card, .large-news-card"
                );


            newsCards.forEach(card => {

                const text =
                    card.textContent.toLowerCase();

                if (text.includes(search)) {

                    card.style.display = "";

                } else {

                    card.style.display = "none";
                }
            });


            /*
             * Recherche des documents
             */

            const files =
                document.querySelectorAll(".file-row");


            files.forEach(file => {

                const text =
                    file.textContent.toLowerCase();

                if (text.includes(search)) {

                    file.style.display = "";

                } else {

                    file.style.display = "none";
                }
            });


            /*
             * Recherche dans les dossiers
             */

            const folders =
                document.querySelectorAll(".folder-item");

            folders.forEach(folder => {

                const text =
                    folder.textContent.toLowerCase();

                if (text.includes(search)) {

                    folder.style.display = "";

                } else {

                    folder.style.display = "none";
                }
            });

        });

    });


    /* =========================================
       CATEGORY FILTER
    ========================================= */

    const newsSelect =
        document.querySelector(".news-toolbar select");


    if (newsSelect) {

        newsSelect.addEventListener("change", () => {

            const selected =
                newsSelect.value.toLowerCase();


            const cards =
                document.querySelectorAll(
                    ".large-news-card"
                );


            cards.forEach(card => {

                if (
                    selected === "toutes les catégories" ||
                    selected === ""
                ) {

                    card.style.display = "";

                    return;
                }


                const tag =
                    card.querySelector(".tag");


                if (!tag) return;


                const category =
                    tag.textContent.toLowerCase();


                if (category.includes(selected)) {

                    card.style.display = "";

                } else {

                    card.style.display = "none";
                }

            });

        });

    }


    /* =========================================
       DOCUMENT TYPE FILTER
    ========================================= */

    const documentSelect =
        document.querySelector(
            ".document-toolbar select"
        );


    if (documentSelect) {

        documentSelect.addEventListener("change", () => {

            const selected =
                documentSelect.value.toLowerCase();


            const files =
                document.querySelectorAll(".file-row");


            files.forEach(file => {

                if (
                    selected === "tous les types" ||
                    selected === ""
                ) {

                    file.style.display = "";

                    return;
                }


                const text =
                    file.textContent.toLowerCase();


                if (text.includes(selected)) {

                    file.style.display = "";

                } else {

                    file.style.display = "none";
                }

            });

        });

    }


    /* =========================================
       FOLDER TREE
    ========================================= */

    const treeItems =
        document.querySelectorAll(".tree-item");


    treeItems.forEach(item => {

        item.addEventListener("click", () => {

            /*
             * Sélection du dossier
             */

            treeItems.forEach(x => {
                x.classList.remove("selected");
            });

            item.classList.add("selected");

        });

    });


});

