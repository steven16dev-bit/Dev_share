1. Structure de FileList.tsx

Remplace la partie qui affiche les cards par :

<div className="files-table-wrapper">

  <table className="files-table">

    <thead>
      <tr>
        <th className="file-check-column">
          <input type="checkbox" />
        </th>

        <th>Nom</th>
        <th>Type</th>
        <th>Taille</th>
        <th>Date de modification</th>
        <th className="file-actions-column">
          Actions
        </th>
      </tr>
    </thead>

    <tbody>

      {files.map((file) => (
        <tr key={file.id}>

          <td>
            <input type="checkbox" />
          </td>

          <td>
            <div className="file-table-name">

              <div className="file-table-icon">
                📄
              </div>

              <span
                title={file.fileName}
              >
                {file.fileName}
              </span>

            </div>
          </td>

          <td>
            <span className="file-type-badge">
              {file.contentType ?? "Fichier"}
            </span>
          </td>

          <td>
            {formatFileSize(file.fileSize)}
          </td>

          <td>
            {formatDate(file.updatedAt)}
          </td>

          <td>
            <div className="file-table-actions">

              <button
                type="button"
                title="Télécharger"
              >
                ↓
              </button>

              <button
                type="button"
                title="Plus d'actions"
              >
                ⋮
              </button>

            </div>
          </td>

        </tr>
      ))}

    </tbody>

  </table>

</div>


