.profile-wrapper {
    position: relative;
}

.profile-menu {

    position: absolute;

    right: 0;

    top: 55px;

    width: 280px;

    background: white;

    border: 1px solid var(--border);

    border-radius: 14px;

    box-shadow:
        0 15px 40px rgba(0,0,0,.14);

    padding: 10px;

    display: none;

    z-index: 2000;
}

.profile-menu.show {
    display: block;
}


.profile-header {

    display: flex;

    align-items: center;

    gap: 12px;

    padding: 12px;

    margin-bottom: 8px;

    background: #f7f9fc;

    border-radius: 10px;
}

.profile-header img {

    width: 42px;
    height: 42px;

    border-radius: 50%;
}

.profile-header strong {

    display: block;

    font-size: 13px;
}

.profile-header span {

    display: block;

    font-size: 11px;

    color: #667085;

    margin-top: 3px;
}


.profile-menu a {

    display: flex;

    align-items: center;

    gap: 12px;

    padding: 12px;

    color: var(--text);

    text-decoration: none;

    border-radius: 8px;

    font-size: 13px;
}

.profile-menu a:hover {

    background: #f2f5f9;
}

.profile-menu a i {

    width: 20px;

    color: #667085;
}

.profile-separator {

    height: 1px;

    background: var(--border);

    margin: 7px 0;
}

.profile-menu .logout {

    color: #d92d20;
}

.profile-menu .logout i {

    color: #d92d20;
}

