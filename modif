3. SanitizeFolderName

Dans FolderService, garde également :

private static string SanitizeFolderName(
    string name)
{
    foreach (
        var character
        in Path.GetInvalidFileNameChars())
    {
        name = name.Replace(
            character,
            '_'
        );
    }

    return name.Trim();
}


