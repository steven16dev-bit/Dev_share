  const [actualites, setActualites] =
    useState<Actualite[]>(actualitesInitiales);

  const [modalOuvert, setModalOuvert] = useState(false);

  const [actualiteSelectionnee, setActualiteSelectionnee] =
    useState<Actualite | null>(null);

  const ouvrirAjout = () => {
    setActualiteSelectionnee(null);
    setModalOuvert(true);
  };

  const ouvrirModification = (actualite: Actualite) => {
    setActualiteSelectionnee(actualite);
    setModalOuvert(true);
  };

  const fermerModal = () => {
    setModalOuvert(false);
    setActualiteSelectionnee(null);
  };

  const enregistrerActualite = (
    actualite: Omit<Actualite, "id"> & { id?: number }
  ) => {
    if (actualite.id) {
      // UPDATE
      setActualites((ancienneListe) =>
        ancienneListe.map((item) =>
          item.id === actualite.id
            ? {
                ...actualite,
                id: actualite.id!,
              }
            : item
        )
      );
    } else {
      // CREATE
      const nouvelId =
        actualites.length > 0
          ? Math.max(...actualites.map((item) => item.id)) + 1
          : 1;

      const nouvelleActualite: Actualite = {
        ...actualite,
        id: nouvelId,
      };

      setActualites((ancienneListe) => [
        nouvelleActualite,
        ...ancienneListe,
      ]);
    }

    fermerModal();
  };

  const supprimerActualite = (id: number) => {
    const confirmation = window.confirm(
      "Voulez-vous vraiment supprimer cette actualité ?"
    );

    if (!confirmation) return;

    setActualites((ancienneListe) =>
      ancienneListe.filter((item) => item.id !== id)
    );
  };

  return (
    <main className={styles.page}>
      <ActualitesTable
        actualites={actualites}
        onAjouter={ouvrirAjout}
        onModifier={ouvrirModification}
        onSupprimer={supprimerActualite}
      />

      {modalOuvert && (
        <ActualiteModal
          actualite={actualiteSelectionnee}
          onFermer={fermerModal}
          onEnregistrer={enregistrerActualite}
        />
      )}
    </main>
  );
}

