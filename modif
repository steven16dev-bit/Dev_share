2. Pagination toujours affichée

Votre ancien code contient probablement ceci :

if (totalPages <= 1) {
    return;
}

Supprimez cette partie.

Remplacez complètement renderPagination() par :

function renderPagination(totalPages) {

    const pagination =
        document.getElementById("pagination");


    pagination.innerHTML = "";


    /*
       Toujours afficher la pagination
    */

    if (totalPages < 1) {
        totalPages = 1;
    }


    /* ============================
       PRÉCÉDENT
    ============================ */

    const previous =
        createPageButton(
            "‹",
            currentPage - 1
        );


    previous.disabled =
        currentPage <= 1;


    pagination.appendChild(
        previous
    );


    /* ============================
       NUMÉROS
    ============================ */

    for (
        let i = 1;
        i <= totalPages;
        i++
    ) {

        const button =
            createPageButton(
                i,
                i
            );


        if (i === currentPage) {

            button.classList.add(
                "active"
            );

        }


        pagination.appendChild(
            button
        );

    }


    /* ============================
       SUIVANT
    ============================ */

    const next =
        createPageButton(
            "›",
            currentPage + 1
        );


    next.disabled =
        currentPage >= totalPages;


    pagination.appendChild(
        next
    );

}


