2. Modifier FileService.cs

Voici la partie importante.

Déterminer le chemin physique correspondant au dossier Oracle

private async Task<string> GetFolderPhysicalPathAsync(
    long folderId)
{
    var folders = new List<(string Name, long? ParentId)>();

    await using var connection = _factory.Create();

    await connection.OpenAsync();

    const string sql = """
        SELECT
            NAME,
            PARENT_ID
        FROM FILE_FOLDERS
        START WITH ID = :folderId
        CONNECT BY PRIOR PARENT_ID = ID
        """;

    await using var command =
        new OracleCommand(sql, connection);

    command.Parameters.Add(
        "folderId",
        OracleDbType.Int64
    ).Value = folderId;

    await using var reader =
        await command.ExecuteReaderAsync();

    while (await reader.ReadAsync())
    {
        folders.Add(
            (
                reader.GetString(0),
                reader.IsDBNull(1)
                    ? null
                    : reader.GetInt64(1)
            )
        );
    }

    if (folders.Count == 0)
        throw new Exception(
            "Dossier introuvable."
        );

    // Oracle retourne normalement :
    // CDI -> 2026 -> Contrats -> RH -> Documents
    //
    // On inverse :
    // Documents -> RH -> Contrats -> 2026 -> CDI

    folders.Reverse();

    var path = StorageRoot;

    foreach (var folder in folders)
    {
        path = Path.Combine(
            path,
            SanitizeFolderName(folder.Name)
        );
    }

    return path;
}


