3. Remplacez openViewer()

function openViewer(id) {

    const selectedFile = documents.find(
        file => file.id === id
    );

    if (!selectedFile) {
        console.error("Document introuvable :", id);
        return;
    }


    /* ==========================================
       MOBILE
       ========================================== */

    if (
        window.matchMedia("(max-width: 800px)").matches
    ) {

        window.open(
            selectedFile.url,
            "_blank"
        );

        return;
    }


    /* ==========================================
       DESKTOP
       ========================================== */

    currentDocument = selectedFile;


    const viewer =
        document.getElementById(
            "pdfViewerPanel"
        );

    const pdf =
        document.getElementById(
            "pdfViewer"
        );

    const title =
        document.getElementById(
            "viewerTitle"
        );


    if (!viewer || !pdf || !title) {

        console.error(
            "Éléments du viewer introuvables"
        );

        return;
    }


    /* Titre */

    title.textContent =
        selectedFile.name;


    /* PDF */

    pdf.src =
        selectedFile.url +
        "#toolbar=1&navpanes=1";


    /*
       Ajouter la classe au layout
       pour créer la colonne du viewer
    */

    document
        .querySelector(".layout")
        .classList.add("viewer-open");


    /*
       Ouvrir le viewer
    */

    requestAnimationFrame(() => {

        viewer.classList.add("open");

    });

}


