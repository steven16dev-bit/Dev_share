<style>

/* =========================================================
   RESET
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Inter, Arial, sans-serif;
    background: #f5f7fb;
    color: #172033;
}


/* =========================================================
   HEADER
========================================================= */

.header {
    height: 76px;
    background: #fff;
    border-bottom: 1px solid #e5e9f0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 28px;

    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;

    font-size: 20px;
    font-weight: 700;
}

.logo-icon {
    width: 38px;
    height: 38px;

    border-radius: 10px;

    background: #1677ff;

    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    font-weight: bold;
}

.nav {
    display: flex;
    gap: 35px;
}

.nav a {
    text-decoration: none;
    color: #344054;
    font-size: 14px;
}

.nav a.active {
    color: #1677ff;
    font-weight: 600;
}

.header-search {
    width: 260px;
}

.header-search input {
    width: 100%;
    height: 40px;

    border: 1px solid #e1e5eb;
    border-radius: 22px;

    padding: 0 18px;

    outline: none;
}


/* =========================================================
   LAYOUT
========================================================= */

.layout {
    display: grid;

    grid-template-columns: 250px 1fr 48%;

    height: calc(100vh - 76px);
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {
    background: white;
    border-right: 1px solid #e5e9f0;

    padding: 22px 14px;

    overflow-y: auto;
}

.sidebar-title {
    font-size: 17px;
    font-weight: 700;

    padding: 0 10px 18px;
}

.tree {
    list-style: none;
}

.tree-item {
    margin-bottom: 3px;
}

.tree-row {
    min-height: 40px;

    display: flex;
    align-items: center;

    gap: 8px;

    padding: 7px 9px;

    border-radius: 8px;

    cursor: pointer;

    font-size: 14px;
}

.tree-row:hover {
    background: #f1f6ff;
}

.tree-row.active {
    background: #eaf3ff;
    color: #1677ff;
    font-weight: 600;
}

.folder-arrow {
    width: 16px;

    text-align: center;

    font-size: 11px;

    transition: transform .2s;
}

.folder-arrow.open {
    transform: rotate(90deg);
}

.folder-icon {
    width: 20px;
}

.folder-name {
    flex: 1;
}

.file-count {
    min-width: 26px;
    height: 22px;

    padding: 0 7px;

    border-radius: 12px;

    background: #eef2f7;

    color: #667085;

    font-size: 11px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.tree-row.active .file-count {
    background: #1677ff;
    color: white;
}

.children {
    display: none;

    padding-left: 18px;
}

.children.open {
    display: block;
}


/* =========================================================
   CONTENT
========================================================= */

.content {
    padding: 26px;

    overflow-y: auto;

    min-width: 0;
}

.page-title {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-bottom: 20px;
}

.page-title h1 {
    font-size: 25px;
}

.page-title p {
    color: #667085;
    font-size: 13px;
    margin-top: 5px;
}


/* =========================================================
   FILTERS
========================================================= */

.filters {
    background: white;

    border: 1px solid #e5e9f0;

    border-radius: 12px;

    padding: 15px;

    display: grid;

    grid-template-columns: 1fr 150px 150px 180px;

    gap: 10px;

    margin-bottom: 20px;
}

.input,
.select {
    height: 40px;

    border: 1px solid #dfe4ea;

    border-radius: 8px;

    padding: 0 12px;

    outline: none;

    background: white;
}

.input:focus,
.select:focus {
    border-color: #1677ff;
}


/* =========================================================
   TOOLBAR
========================================================= */

.toolbar {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 15px;
}

.result-count {
    font-size: 13px;
    color: #667085;
}


/* =========================================================
   DOCUMENT GRID
========================================================= */

.documents {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 16px;
}

.document-card {
    background: white;

    border: 1px solid #e5e9f0;

    border-radius: 12px;

    overflow: hidden;

    transition: .2s;
}

.document-card:hover {
    transform: translateY(-2px);

    box-shadow: 0 8px 25px rgba(16, 24, 40, .08);
}


/* PDF COVER */

.pdf-cover {
    height: 220px;

    background: #eef2f6;

    position: relative;

    overflow: hidden;

    cursor: pointer;
}

.pdf-cover iframe {
    width: 100%;
    height: 100%;

    border: none;

    pointer-events: none;

    transform: scale(1);
}

.pdf-label {
    position: absolute;

    top: 10px;
    left: 10px;

    background: #e53935;

    color: white;

    font-size: 10px;

    font-weight: 700;

    padding: 5px 7px;

    border-radius: 5px;
}


/* CARD INFO */

.card-body {
    padding: 13px;
}

.file-name {
    font-size: 13px;

    font-weight: 600;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}

.file-meta {
    display: flex;

    gap: 8px;

    color: #667085;

    font-size: 11px;

    margin-top: 6px;
}

.card-actions {
    display: flex;

    gap: 8px;

    margin-top: 12px;
}

.btn {
    flex: 1;

    height: 34px;

    border-radius: 7px;

    border: 1px solid #dfe4ea;

    background: white;

    cursor: pointer;

    font-size: 12px;
}

.btn:hover {
    background: #f5f8fc;
}

.btn.primary {
    background: #1677ff;

    color: white;

    border-color: #1677ff;
}


/* =========================================================
   PAGINATION
========================================================= */

.pagination {
    display: flex;

    justify-content: center;

    gap: 5px;

    margin-top: 25px;

    padding-bottom: 20px;
}

.page-btn {
    width: 36px;
    height: 36px;

    border: 1px solid #dfe4ea;

    background: white;

    border-radius: 7px;

    cursor: pointer;
}

.page-btn.active {
    background: #1677ff;
    color: white;

    border-color: #1677ff;
}


/* =========================================================
   PDF VIEWER
========================================================= */

.viewer {
    background: #17202d;

    display: flex;

    flex-direction: column;

    min-width: 0;
}

.viewer-header {
    height: 58px;

    background: #202b3a;

    color: white;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 16px;
}

.viewer-title {
    display: flex;

    align-items: center;

    gap: 10px;

    font-size: 13px;

    font-weight: 600;
}

.viewer-close {
    border: none;

    background: transparent;

    color: white;

    font-size: 22px;

    cursor: pointer;
}

.viewer-toolbar {
    height: 48px;

    background: #17202d;

    color: white;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 12px;
}

.viewer-toolbar button {
    border: none;

    background: transparent;

    color: white;

    cursor: pointer;

    font-size: 13px;
}

.viewer-body {
    flex: 1;

    padding: 15px;

    display: flex;

    justify-content: center;

    overflow: hidden;
}

.viewer-body iframe {
    width: 100%;
    height: 100%;

    border: none;

    background: #555;
}


/* =========================================================
   EMPTY
========================================================= */

.empty {
    grid-column: 1 / -1;

    background: white;

    border: 1px dashed #ccd3dd;

    border-radius: 12px;

    padding: 50px;

    text-align: center;

    color: #667085;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width: 1200px) {

    .layout {
        grid-template-columns: 220px 1fr;
    }

    .viewer {
        display: none;
    }

    .documents {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(max-width: 800px) {

    .nav {
        display: none;
    }

    .header-search {
        width: 180px;
    }

    .layout {
        display: block;

        height: auto;
    }

    .sidebar {
        border-right: none;
        border-bottom: 1px solid #e5e9f0;
    }

    .documents {
        grid-template-columns: 1fr;
    }

    .filters {
        grid-template-columns: 1fr;
    }

    .content {
        padding: 15px;
    }
}

</style>
</head>


