Oui. Voici une version adaptée à ton gestionnaire de fichiers Next.js 16 + TypeScript, sans dépendance supplémentaire.

L'idée est simple : à partir du selectedFolderId, on remonte les parentId jusqu'à la racine, puis on inverse le tableau.

1. components/Breadcrumb.tsx

"use client"

import type { Folder } from "@/lib/types"

interface BreadcrumbProps {
  folders: Folder[]
  selectedFolderId: number | null
  onNavigate: (folderId: number) => void
}

export default function Breadcrumb({
  folders,
  selectedFolderId,
  onNavigate,
}: BreadcrumbProps) {

  // Construire le chemin complet
  const buildPath = (): Folder[] => {
    if (selectedFolderId === null) {
      return []
    }

    const path: Folder[] = []

    let currentId: number | null = selectedFolderId

    while (currentId !== null) {
      const folder = folders.find(
        f => f.id === currentId
      )

      if (!folder) {
        break
      }

      path.push(folder)
      currentId = folder.parentId
    }

    // On remonte de la racine vers le dossier courant
    return path.reverse()
  }

  const path = buildPath()

  return (
    <nav
      className="breadcrumb"
      aria-label="Chemin du dossier"
    >

      {/* Accueil */}
      <button
        type="button"
        className="breadcrumb-item breadcrumb-home"
        onClick={() => {
          if (folders.length > 0) {
            const rootFolder = folders.find(
              folder => folder.parentId === null
            )

            if (rootFolder) {
              onNavigate(rootFolder.id)
            }
          }
        }}
      >
        🏠 Accueil
      </button>

      {path.map((folder, index) => {
        const isLast = index === path.length - 1

        return (
          <div
            key={folder.id}
            className="breadcrumb-part"
          >
            <span className="breadcrumb-separator">
              /
            </span>

            {isLast ? (
              <span className="breadcrumb-current">
                {folder.name}
              </span>
            ) : (
              <button
                type="button"
                className="breadcrumb-item"
                onClick={() => onNavigate(folder.id)}
              >
                {folder.name}
              </button>
            )}
          </div>
        )
      })}
    </nav>
  )
}


