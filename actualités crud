  padding: 5px 9px;

  border-radius: 6px;

  background: #eef4ff;
  color: #315fbe;

  font-size: 12px;
  font-weight: 600;
}

.dateCell {
  white-space: nowrap;
  color: #687386 !important;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.tag {
  padding: 4px 7px;

  border-radius: 5px;

  background: #f1f3f6;
  color: #687386;

  font-size: 11px;
}

.actionsHeader {
  text-align: right !important;
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 7px;
}

.actionButton {
  width: 34px;
  height: 34px;

  border: 0;
  border-radius: 7px;

  cursor: pointer;

  transition:
    background 0.2s,
    transform 0.15s;
}

.actionButton:hover {
  transform: translateY(-1px);
}

.editButton {
  background: #eef4ff;
  color: #2563eb;
}

.editButton:hover {
  background: #dbe8ff;
}

.deleteButton {
  background: #fff0f0;
  color: #dc2626;
}

.deleteButton:hover {
  background: #ffe0e0;
}

.empty {
  padding: 50px !important;

  text-align: center;

  color: #8a94a6 !important;
}

/* =========================
   FOOTER / PAGINATION
========================= */

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 18px 4px;
}

.resultCount {
  color: #7b8494;
  font-size: 13px;
}

.pagination {
  display: flex;
  align-items: center;
  gap: 5px;
}

.pageButton {
  width: 34px;
  height: 34px;

  border: 1px solid #e1e6ed;
  border-radius: 7px;

  background: white;

  color: #596579;

  cursor: pointer;
}

.pageButton:hover:not(:disabled) {
  background: #f3f6fb;
}

.pageButton:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.activePage {
  border-color: #1d4ed8;
  background: #1d4ed8;
  color: white;
}

/* =========================
   MODAL
========================= */

.modalOverlay {
  position: fixed;

  inset: 0;

  z-index: 1000;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(15, 23, 42, 0.55);

  backdrop-filter: blur(3px);
}

.modal {
  width: 100%;
  max-width: 720px;
  max-height: 92vh;

  overflow-y: auto;

  background: white;

  border-radius: 14px;

  box-shadow:
    0 25px 60px rgba(0, 0, 0, 0.2);

  animation: modalOpen 0.2s ease-out;
}

@keyframes modalOpen {
  from {
    opacity: 0;
    transform: translateY(15px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* =========================
   MODAL HEADER
========================= */

.modalHeader {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  padding: 22px 24px;

  border-bottom: 1px solid #edf0f4;
}

.modalTitle {
  margin: 0;

  font-size: 20px;
  font-weight: 700;

  color: #172033;
}

.modalSubtitle {
  margin: 5px 0 0;

  color: #8992a2;

  font-size: 13px;
}

.closeButton {
  width: 34px;
  height: 34px;

  border: 0;
  border-radius: 7px;

  background: transparent;

  color: #687386;

  font-size: 25px;

  cursor: pointer;
}

.closeButton:hover {
  background: #f1f3f6;
}

/* =========================
   FORM
========================= */

.form {
  padding: 24px;
}

.formGroup {
  display: flex;
  flex-direction: column;

  gap: 7px;

  margin-bottom: 18px;
}

.formGroup label {
  color: #374151;

  font-size: 13px;
  font-weight: 600;
}

.formGroup label span {
  color: #dc2626;
}

.input,
.textarea {
  width: 100%;

  box-sizing: border-box;

  padding: 10px 12px;

  border: 1px solid #dfe4eb;
  border-radius: 8px;

  outline: none;

  color: #293244;

  background: white;

  font-family: inherit;
  font-size: 14px;

  transition: border 0.2s;
}

.input {
  height: 42px;
}

.textarea {
  resize: vertical;
  line-height: 1.5;
}

.input:focus,
.textarea:focus {
  border-color: #1d4ed8;
}

.formGrid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 16px;
}

/* =========================
   TAG INPUT
========================= */

.tagsInput {
  display: flex;
  flex-wrap: wrap;
  align-items: center;

  gap: 6px;

  min-height: 42px;

  padding: 5px 8px;

  box-sizing: border-box;

  border: 1px solid #dfe4eb;
  border-radius: 8px;

  background: white;
}

.tagsInput:focus-within {
  border-color: #1d4ed8;
}

.tagsInput > input {
  flex: 1;

  min-width: 130px;

  height: 30px;

  border: 0;

  outline: none;

  font-family: inherit;
  font-size: 13px;
}

.formTag {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  padding: 5px 8px;

  border-radius: 6px;

  background: #eef4ff;
  color: #315fbe;

  font-size: 12px;
}

.formTag button {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 16px;
  height: 16px;

  padding: 0;

  border: 0;

  background: transparent;

  color: #315fbe;

  cursor: pointer;

  font-size: 15px;
}

.formGroup small {
  color: #929aaa;
  font-size: 11px;
}

/* =========================
   MODAL ACTIONS
========================= */

.modalActions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;

  padding-top: 8px;
}

.cancelButton,
.saveButton {
  height: 42px;

  padding: 0 17px;

  border-radius: 8px;

  font-size: 13px;
  font-weight: 600;

  cursor: pointer;
}

.cancelButton {
  border: 1px solid #dfe4eb;

  background: white;

  color: #596579;
}

.cancelButton:hover {
  background: #f7f8fa;
}

.saveButton {
  border: 0;

  background: #1d4ed8;

  color: white;
}

.saveButton:hover {
  background: #1e40af;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 768px) {
  .page {
    padding: 18px;
  }

  .header {
    align-items: flex-start;
    gap: 15px;
  }

  .title {
    font-size: 23px;
  }

  .toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .categorySelect {
    width: 100%;
  }

  .formGrid {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .modalOverlay {
    padding: 10px;
  }

  .modal {
    max-height: 95vh;
  }

  .modalHeader,
  .form {
    padding: 18px;
  }

  .modalActions {
    flex-direction: column-reverse;
  }

  .cancelButton,
  .saveButton {
    width: 100%;
  }
}

@media (max-width: 500px) {
  .page {
    padding: 12px;
  }

  .header {
    flex-direction: column;
  }

  .addButton {
    width: 100%;
    justify-content: center;
  }

  .footer {
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
}

Résultat

Tu obtiens donc cette architecture :

admin/actualites/page.tsx
        │
        ├── ActualitesTable
        │       │
        │       ├── Recherche
        │       ├── Filtre catégorie
        │       ├── Tableau
        │       ├── Modifier
        │       ├── Supprimer
        │       └── Pagination
        │
        └── ActualiteModal
                │
                ├── Ajouter
                ├── Modifier
                ├── Catégorie
                ├── Date
                └── Mots clés

Le CRUD fonctionne déjà :

Create

Ajouter → formulaire → Enregistrer → nouvelle ligne

Read

actualitesInitiales → tableau

Update

Modifier → formulaire pré-rempli → Enregistrer → ligne modifiée

Delete

Supprimer → confirmation → ligne supprimée

La prochaine étape logique pour ton projet est de remplacer actualitesInitiales et les setActualites(...) par les appels à ton API .NET Core, par exemple GET /api/actualites, POST, PUT et DELETE, tout en gardant exactement cette interface.