function openViewer(id) {

    const selectedFile = documents.find(
        file => file.id === id
    );

    if (!selectedFile) return;

    currentDocument = selectedFile;


    // Détection mobile
    const isMobile =
        window.matchMedia("(max-width: 800px)").matches;


    // MOBILE
    if (isMobile) {

        window.open(
            selectedFile.url,
            "_blank"
        );

        return;
    }


    // DESKTOP
    document.getElementById(
        "viewerTitle"
    ).textContent =
        selectedFile.name;


    document.getElementById(
        "pdfViewer"
    ).src =
        selectedFile.url +
        "#toolbar=1&navpanes=1";

}