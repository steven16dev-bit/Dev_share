2. Méthode qui met à jour FILE_PATH

Utilise cette version :

private async Task UpdateDescendantFilePathsAsync(
    OracleConnection connection,
    OracleTransaction transaction,
    long folderId)
{
    // ==========================================
    // RÉCUPÉRER TOUS LES FICHIERS DU DOSSIER
    // ET DE SES SOUS-DOSSIERS
    // ==========================================

    const string sql = """
        SELECT
            ID,
            FOLDER_ID,
            FILE_NAME
        FROM FILE_DOCUMENTS
        WHERE FOLDER_ID IN
        (
            SELECT ID
            FROM FILE_FOLDERS
            START WITH ID = :folderId
            CONNECT BY PRIOR ID = PARENT_ID
        )
        """;

    var files =
        new List<(
            long Id,
            long FolderId,
            string FileName
        )>();


    await using (
        var command =
            new OracleCommand(
                sql,
                connection
            ))
    {
        command.Transaction =
            transaction;

        command.Parameters.Add(
            "folderId",
            OracleDbType.Int64
        ).Value = folderId;

        await using var reader =
            await command.ExecuteReaderAsync();

        while (await reader.ReadAsync())
        {
            files.Add(
                (
                    reader.GetInt64(0),
                    reader.GetInt64(1),
                    reader.GetString(2)
                )
            );
        }
    }


    // ==========================================
    // RECALCULER LE PATH
    // ==========================================

    foreach (var file in files)
    {
        var folderPath =
            await GetFolderPhysicalPathAsync(
                file.FolderId
            );

        var newFilePath =
            Path.Combine(
                folderPath,
                file.FileName
            );


        const string updateSql = """
            UPDATE FILE_DOCUMENTS
            SET
                FILE_PATH = :filePath,
                UPDATED_AT = SYSTIMESTAMP
            WHERE ID = :id
            """;

        await using var command =
            new OracleCommand(
                updateSql,
                connection
            );

        command.Transaction =
            transaction;

        command.Parameters.Add(
            "filePath",
            OracleDbType.Varchar2
        ).Value = newFilePath;

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = file.Id;

        await command.ExecuteNonQueryAsync();
    }
}


