"use client"

import Link from "next/link"
import { usePathname } from "next/navigation"

export default function AdminSidebar() {
  const pathname = usePathname()

  const isActive = (path: string) => {
    return pathname === path ||
      pathname.startsWith(`${path}/`)
  }

  return (
    <aside className="admin-sidebar">

      {/* Logo */}
      <div className="admin-sidebar-logo">
        <div className="admin-logo-icon">
          ◈
        </div>

        <div className="admin-logo-text">
          <span>PORTAIL</span>
          <strong>ADMIN</strong>
        </div>
      </div>

      {/* Menu */}
      <nav className="admin-sidebar-menu">

        <div className="admin-menu-title">
          MENU
        </div>

        <Link
          href="/admin/actualites"
          className={
            `admin-menu-item ${
              isActive("/admin/actualites")
                ? "active"
                : ""
            }`
          }
        >
          <span className="admin-menu-icon">
            📰
          </span>

          <span>
            Actualités
          </span>
        </Link>

        <Link
          href="/admin/documents"
          className={
            `admin-menu-item ${
              isActive("/admin/documents")
                ? "active"
                : ""
            }`
          }
        >
          <span className="admin-menu-icon">
            📁
          </span>

          <span>
            Documents
          </span>
        </Link>

      </nav>

      {/* Bottom */}
      <div className="admin-sidebar-bottom">

        <div className="admin-user">

          <div className="admin-user-avatar">
            S
          </div>

          <div className="admin-user-info">
            <strong>Sidali</strong>
            <span>Administrateur</span>
          </div>

          <button
            className="admin-settings-button"
            type="button"
          >
            ⚙
          </button>

        </div>

      </div>

    </aside>
  )
}

---
css

.admin-sidebar {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;

  width: 240px;

  display: flex;
  flex-direction: column;

  background: #101d33;
  color: #ffffff;

  z-index: 1000;
}

/* =========================
   LOGO
========================= */

.admin-sidebar-logo {
  height: 76px;

  display: flex;
  align-items: center;

  padding: 0 24px;

  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.admin-logo-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-right: 10px;

  border-radius: 10px;

  background: #1769ff;

  font-size: 22px;
}

.admin-logo-text {
  display: flex;
  flex-direction: column;

  line-height: 1.1;
}

.admin-logo-text span {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.admin-logo-text strong {
  color: #4d9aff;

  font-size: 13px;
  letter-spacing: 1px;
}

/* =========================
   MENU
========================= */

.admin-sidebar-menu {
  padding: 24px 12px;
}

.admin-menu-title {
  padding: 0 14px 12px;

  color: #71809a;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 1px;
}

.admin-menu-item {
  position: relative;

  height: 46px;

  display: flex;
  align-items: center;

  gap: 12px;

  margin-bottom: 5px;
  padding: 0 14px;

  border-radius: 8px;

  color: #c5cfdf;

  text-decoration: none;

  font-size: 14px;
  font-weight: 500;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.admin-menu-item:hover {
  background: rgba(255,255,255,0.07);
  color: #ffffff;
}

.admin-menu-item.active {
  background: #1769ff;
  color: #ffffff;
}

.admin-menu-item.active::before {
  content: "";

  position: absolute;

  left: 0;
  top: 10px;
  bottom: 10px;

  width: 3px;

  border-radius: 0 3px 3px 0;

  background: #ffffff;
}

.admin-menu-icon {
  width: 22px;

  display: flex;
  justify-content: center;

  font-size: 17px;
}

/* =========================
   BOTTOM USER
========================= */

.admin-sidebar-bottom {
  margin-top: auto;

  padding: 16px;

  border-top: 1px solid rgba(255,255,255,0.08);
}

.admin-user {
  display: flex;
  align-items: center;

  gap: 10px;
}

.admin-user-avatar {
  width: 38px;
  height: 38px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #334155;

  font-size: 14px;
  font-weight: 700;
}

.admin-user-info {
  min-width: 0;

  display: flex;
  flex-direction: column;

  flex: 1;
}

.admin-user-info strong {
  font-size: 13px;
  color: #ffffff;
}

.admin-user-info span {
  margin-top: 2px;

  color: #7f8da5;

  font-size: 11px;
}

.admin-settings-button {
  width: 32px;
  height: 32px;

  border: 0;
  background: transparent;

  color: #aeb9cb;

  border-radius: 7px;

  cursor: pointer;

  font-size: 16px;
}

.admin-settings-button:hover {
  background: rgba(255,255,255,0.08);
  color: #ffffff;
}