9. Côté Next.js

Il faut maintenant récupérer le 409.

Dans api.ts :

export async function uploadFile(
  folderId: number,
  file: File
) {
  const formData = new FormData()

  formData.append("file", file)

  const response = await fetch(
    `${API}/files/upload/${folderId}`,
    {
      method: "POST",
      body: formData
    }
  )

  if (response.status === 409) {

    const error =
      await response.json()

    throw new Error(
      error.message
    )
  }

  if (!response.ok) {
    throw new Error(
      "Erreur pendant l'upload."
    )
  }

  return response.json()
}


