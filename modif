Oui. Le problème vient probablement du fait que le renommage physique fonctionne, mais que FILE_DOCUMENTS.FILE_PATH n'est pas correctement recalculé après le changement du dossier.

Le plus robuste est de faire le renommage dans FolderService, puis de recalculer les chemins de tous les fichiers descendants après avoir changé le nom du dossier dans Oracle.

Voici la correction.

1. RenameAsync complet

Remplace ton RenameAsync par celui-ci :

public async Task RenameAsync(
    long folderId,
    string newName)
{
    if (string.IsNullOrWhiteSpace(newName))
        throw new Exception(
            "Le nom du dossier est obligatoire."
        );

    newName = SanitizeFolderName(newName.Trim());

    if (string.IsNullOrWhiteSpace(newName))
        throw new Exception(
            "Nom de dossier invalide."
        );


    // ==========================================
    // 1. RÉCUPÉRER LE DOSSIER
    // ==========================================

    Folder? folder = null;

    await using (var connection = _factory.Create())
    {
        await connection.OpenAsync();

        const string sql = """
            SELECT
                ID,
                NAME,
                PARENT_ID,
                CREATED_AT,
                UPDATED_AT
            FROM FILE_FOLDERS
            WHERE ID = :id
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = folderId;

        await using var reader =
            await command.ExecuteReaderAsync();

        if (await reader.ReadAsync())
        {
            folder = new Folder
            {
                Id = reader.GetInt64(0),

                Name = reader.GetString(1),

                ParentId =
                    reader.IsDBNull(2)
                        ? null
                        : reader.GetInt64(2),

                CreatedAt =
                    reader.GetDateTime(3),

                UpdatedAt =
                    reader.GetDateTime(4)
            };
        }
    }

    if (folder == null)
        throw new Exception(
            "Dossier introuvable."
        );


    // ==========================================
    // 2. VÉRIFIER SI LE NOM EST IDENTIQUE
    // ==========================================

    if (
        string.Equals(
            folder.Name,
            newName,
            StringComparison.OrdinalIgnoreCase
        )
    )
    {
        return;
    }


    // ==========================================
    // 3. VÉRIFIER DOUBLON
    // ==========================================

    await using (var connection = _factory.Create())
    {
        await connection.OpenAsync();

        const string sql = """
            SELECT COUNT(*)
            FROM FILE_FOLDERS
            WHERE ID <> :id
              AND NAME = :name
              AND (
                    PARENT_ID = :parentId
                    OR (
                        PARENT_ID IS NULL
                        AND :parentId IS NULL
                    )
                  )
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = folderId;

        command.Parameters.Add(
            "name",
            OracleDbType.Varchar2
        ).Value = newName;

        command.Parameters.Add(
            "parentId",
            OracleDbType.Int64
        ).Value =
            folder.ParentId.HasValue
                ? folder.ParentId.Value
                : DBNull.Value;

        var count =
            Convert.ToInt32(
                await command.ExecuteScalarAsync()
            );

        if (count > 0)
        {
            throw new Exception(
                $"Le dossier '{newName}' existe déjà."
            );
        }
    }


    // ==========================================
    // 4. ANCIEN CHEMIN PHYSIQUE
    // ==========================================

    var oldPath =
        await GetFolderPhysicalPathAsync(
            folderId
        );


    if (!Directory.Exists(oldPath))
    {
        throw new DirectoryNotFoundException(
            $"Le dossier physique n'existe pas : {oldPath}"
        );
    }


    // ==========================================
    // 5. NOUVEAU CHEMIN PHYSIQUE
    // ==========================================

    var parentPath =
        folder.ParentId.HasValue
            ? await GetFolderPhysicalPathAsync(
                folder.ParentId.Value
            )
            : StorageRoot;


    var newPath =
        Path.Combine(
            parentPath,
            newName
        );


    if (Directory.Exists(newPath))
    {
        throw new IOException(
            $"Le dossier physique existe déjà : {newPath}"
        );
    }


    // ==========================================
    // 6. RENOMMER PHYSIQUEMENT
    // ==========================================

    Directory.Move(
        oldPath,
        newPath
    );


    try
    {
        // ======================================
        // 7. TRANSACTION ORACLE
        // ======================================

        await using var connection =
            _factory.Create();

        await connection.OpenAsync();

        await using var transaction =
            (OracleTransaction)
            await connection.BeginTransactionAsync();

        try
        {
            // ----------------------------------
            // RENOMMER LE DOSSIER
            // ----------------------------------

            const string updateFolderSql = """
                UPDATE FILE_FOLDERS
                SET
                    NAME = :name,
                    UPDATED_AT = SYSTIMESTAMP
                WHERE ID = :id
                """;

            await using (
                var command =
                    new OracleCommand(
                        updateFolderSql,
                        connection
                    ))
            {
                command.Transaction =
                    transaction;

                command.Parameters.Add(
                    "name",
                    OracleDbType.Varchar2
                ).Value = newName;

                command.Parameters.Add(
                    "id",
                    OracleDbType.Int64
                ).Value = folderId;

                await command.ExecuteNonQueryAsync();
            }


            // ----------------------------------
            // METTRE À JOUR LES FILE_PATH
            // ----------------------------------

            await UpdateDescendantFilePathsAsync(
                connection,
                transaction,
                folderId
            );


            // ----------------------------------
            // COMMIT
            // ----------------------------------

            await transaction.CommitAsync();
        }
        catch
        {
            await transaction.RollbackAsync();
            throw;
        }
    }
    catch
    {
        // ======================================
        // ANNULER LE RENOMMAGE PHYSIQUE
        // ======================================

        if (
            Directory.Exists(newPath) &&
            !Directory.Exists(oldPath)
        )
        {
            Directory.Move(
                newPath,
                oldPath
            );
        }

        throw;
    }
}


