5. Vérifier le fichier dans Oracle

Ajoute dans FileService :

private async Task<bool> FileExistsInDatabaseAsync(
    long folderId,
    string fileName)
{
    await using var connection =
        _factory.Create();

    await connection.OpenAsync();

    const string sql = """
        SELECT COUNT(*)
        FROM FILE_DOCUMENTS
        WHERE FOLDER_ID = :folderId
        AND FILE_NAME = :fileName
        """;

    await using var command =
        new OracleCommand(
            sql,
            connection
        );

    command.Parameters.Add(
        "folderId",
        OracleDbType.Int64
    ).Value = folderId;

    command.Parameters.Add(
        "fileName",
        OracleDbType.Varchar2
    ).Value = fileName;

    var result =
        await command.ExecuteScalarAsync();

    return Convert.ToInt32(result) > 0;
}


