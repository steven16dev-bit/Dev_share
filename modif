5. Modifier le chargement initial du dossier

Dans ton useEffect qui charge les dossiers, lorsque tu sélectionnes le dossier racine, utilise :

const folderParam =
  searchParams.get("folder")

if (folderParam) {
  const folderId = Number(folderParam)

  const exists = data.some(
    folder => folder.id === folderId
  )

  if (exists) {
    setSelectedFolderId(folderId)
    return
  }
}

const root = data.find(
  folder => folder.parentId === null
)

if (root) {
  setSelectedFolderId(root.id)

  const params = new URLSearchParams(
    searchParams.toString()
  )

  params.set("folder", String(root.id))
  params.set("page", "1")

  router.replace(
    `${pathname}?${params.toString()}`,
    { scroll: false }
  )
}


