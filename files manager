    } | null>(null)

  async function loadFolders() {
    const data = await getFolders()

    setFolders(data)

    if (!selectedFolder && data.length > 0) {
      setSelectedFolder(data[0])
    }
  }

  async function loadFiles(folderId: number) {
    const data =
      await getFiles(folderId)

    setFiles(data)
  }

  useEffect(() => {
    async function load() {
      setLoading(true)

      await loadFolders()

      setLoading(false)
    }

    load()
  }, [])

  useEffect(() => {
    if (selectedFolder) {
      loadFiles(selectedFolder.id)
    }
  }, [selectedFolder])

  async function handleCreateFolder() {

    const name =
      window.prompt(
        "Nom du nouveau dossier"
      )

    if (!name?.trim())
      return

    await createFolder(
      name.trim(),
      selectedFolder?.id ?? null
    )

    await loadFolders()
  }

  async function handleUpload(
    file: File
  ) {

    if (!selectedFolder)
      return

    await uploadFile(
      selectedFolder.id,
      file
    )

    await loadFiles(
      selectedFolder.id
    )
  }

  async function handleDeleteFolder(
    folder: Folder
  ) {

    const confirmed =
      window.confirm(
        `Supprimer "${folder.name}" ?`
      )

    if (!confirmed)
      return

    await deleteFolder(folder.id)

    if (
      selectedFolder?.id === folder.id
    ) {
      setSelectedFolder(null)
      setFiles([])
    }

    await loadFolders()
  }

  async function handleRename(
    folder: Folder
  ) {

    const name =
      window.prompt(
        "Nouveau nom",
        folder.name
      )

    if (!name?.trim())
      return

    await renameFolder(
      folder.id,
      name.trim()
    )

    await loadFolders()
  }

  async function handleMove(
    folder: Folder,
    target: Folder
  ) {

    if (folder.id === target.id)
      return

    await moveFolder(
      folder.id,
      target.id
    )

    await loadFolders()
  }

  async function handleDeleteFile(
    file: DocumentFile
  ) {

    const confirmed =
      window.confirm(
        `Supprimer "${file.fileName}" ?`
      )

    if (!confirmed)
      return

    await deleteFile(file.id)

    if (selectedFolder) {
      await loadFiles(
