Services/FileService.cs

using DocumentManager.Api.Data;
using DocumentManager.Api.Models;
using Oracle.ManagedDataAccess.Client;

namespace DocumentManager.Api.Services;

public class FileService
{
    private readonly OracleConnectionFactory _factory;
    private readonly IWebHostEnvironment _environment;

    public FileService(
        OracleConnectionFactory factory,
        IWebHostEnvironment environment)
    {
        _factory = factory;
        _environment = environment;
    }

    private string StorageRoot
    {
        get
        {
            var path =
                Path.Combine(
                    _environment.ContentRootPath,
                    "Storage"
                );

            Directory.CreateDirectory(path);

            return path;
        }
    }

    public async Task<List<DocumentFile>> GetByFolderAsync(
        long folderId)
    {
        var result = new List<DocumentFile>();

        await using var connection = _factory.Create();

        await connection.OpenAsync();

        const string sql = """
            SELECT
                ID,
                FOLDER_ID,
                FILE_NAME,
                STORED_NAME,
                FILE_PATH,
                CONTENT_TYPE,
                FILE_SIZE,
                CREATED_AT,
                UPDATED_AT
            FROM FILE_DOCUMENTS
            WHERE FOLDER_ID = :folderId
            ORDER BY FILE_NAME
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "folderId",
            OracleDbType.Int64
        ).Value = folderId;

        await using var reader =
            await command.ExecuteReaderAsync();

        while (await reader.ReadAsync())
        {
            result.Add(new DocumentFile
            {
                Id = reader.GetInt64(0),
                FolderId = reader.GetInt64(1),
                FileName = reader.GetString(2),
                StoredName = reader.GetString(3),
                FilePath = reader.GetString(4),
                ContentType = reader.IsDBNull(5)
                    ? null
                    : reader.GetString(5),
                FileSize = reader.IsDBNull(6)
                    ? 0
                    : reader.GetInt64(6),
                CreatedAt = reader.GetDateTime(7),
                UpdatedAt = reader.GetDateTime(8)
            });
        }

        return result;
    }

    public async Task UploadAsync(
        long folderId,
        IFormFile file)
    {
        if (file.Length == 0)
            throw new Exception("Empty file.");

        var storedName =
            $"{Guid.NewGuid():N}{Path.GetExtension(file.FileName)}";

        var folderPath =
            Path.Combine(
                StorageRoot,
                folderId.ToString()
            );

        Directory.CreateDirectory(folderPath);

        var physicalPath =
            Path.Combine(
                folderPath,
                storedName
            );

        await using (
            var stream =
                new FileStream(
                    physicalPath,
                    FileMode.Create
                ))
        {
            await file.CopyToAsync(stream);
        }

        await using var connection = _factory.Create();

        await connection.OpenAsync();

        const string sql = """
            INSERT INTO FILE_DOCUMENTS
            (
                FOLDER_ID,
                FILE_NAME,
                STORED_NAME,
                FILE_PATH,
                CONTENT_TYPE,
                FILE_SIZE
            )
            VALUES
            (
                :folderId,
                :fileName,
                :storedName,
                :filePath,
                :contentType,
                :fileSize
            )
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "folderId",
            OracleDbType.Int64
        ).Value = folderId;

        command.Parameters.Add(
            "fileName",
            OracleDbType.Varchar2
        ).Value = file.FileName;

        command.Parameters.Add(
            "storedName",
            OracleDbType.Varchar2
        ).Value = storedName;

        command.Parameters.Add(
            "filePath",
            OracleDbType.Varchar2
        ).Value = physicalPath;

        command.Parameters.Add(
            "contentType",
            OracleDbType.Varchar2
        ).Value =
            file.ContentType ??
            "application/octet-stream";

        command.Parameters.Add(
            "fileSize",
            OracleDbType.Int64
        ).Value = file.Length;

        await command.ExecuteNonQueryAsync();
    }

    public async Task<DocumentFile?> GetAsync(long id)
    {
        await using var connection = _factory.Create();

        await connection.OpenAsync();

        const string sql = """
            SELECT
                ID,
                FOLDER_ID,
                FILE_NAME,
                STORED_NAME,
                FILE_PATH,
                CONTENT_TYPE,
                FILE_SIZE,
                CREATED_AT,
                UPDATED_AT
            FROM FILE_DOCUMENTS
            WHERE ID = :id
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = id;

        await using var reader =
            await command.ExecuteReaderAsync();

        if (!await reader.ReadAsync())
            return null;

        return new DocumentFile
        {
            Id = reader.GetInt64(0),
            FolderId = reader.GetInt64(1),
            FileName = reader.GetString(2),
            StoredName = reader.GetString(3),
            FilePath = reader.GetString(4),
            ContentType =
                reader.IsDBNull(5)
                    ? null
                    : reader.GetString(5),
            FileSize =
                reader.IsDBNull(6)
                    ? 0
                    : reader.GetInt64(6),
            CreatedAt = reader.GetDateTime(7),
            UpdatedAt = reader.GetDateTime(8)
        };
    }

    public async Task DeleteAsync(long id)
    {
        var file = await GetAsync(id);

        if (file == null)
            return;

        if (System.IO.File.Exists(file.FilePath))
            System.IO.File.Delete(file.FilePath);

        await using var connection = _factory.Create();

        await connection.OpenAsync();

        const string sql = """
            DELETE FROM FILE_DOCUMENTS
            WHERE ID = :id
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = id;

        await command.ExecuteNonQueryAsync();
    }
}


