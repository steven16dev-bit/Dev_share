Oui. Dans ton architecture, le renommage d'un dossier doit être une opération atomique logique :

Avant

Storage/
└── Documents/
    └── RH/
        └── Contrats/
            └── 2026/
                └── CDI/
                    └── contrat.pdf

Si tu renommes CDI → CDI_2026 :

Après

Storage/
└── Documents/
    └── RH/
        └── Contrats/
            └── 2026/
                └── CDI_2026/
                    └── contrat.pdf

Et Oracle doit également être mis à jour.

Le point important : les chemins des fichiers enfants doivent être recalculés, puisque le chemin physique du dossier parent a changé.

1. Remplacer RenameAsync dans FolderService

public async Task RenameAsync(
    long folderId,
    string newName)
{
    if (string.IsNullOrWhiteSpace(newName))
        throw new Exception("Le nom du dossier est obligatoire.");

    newName = newName.Trim();

    // ==============================
    // RÉCUPÉRER LE DOSSIER
    // ==============================

    Folder? folder = null;

    await using (var connection = _factory.Create())
    {
        await connection.OpenAsync();

        const string sql = """
            SELECT
                ID,
                NAME,
                PARENT_ID,
                CREATED_AT,
                UPDATED_AT
            FROM FILE_FOLDERS
            WHERE ID = :id
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = folderId;

        await using var reader =
            await command.ExecuteReaderAsync();

        if (await reader.ReadAsync())
        {
            folder = new Folder
            {
                Id = reader.GetInt64(0),
                Name = reader.GetString(1),
                ParentId =
                    reader.IsDBNull(2)
                        ? null
                        : reader.GetInt64(2),

                CreatedAt = reader.GetDateTime(3),
                UpdatedAt = reader.GetDateTime(4)
            };
        }
    }

    if (folder == null)
        throw new Exception(
            "Dossier introuvable."
        );


    // ==============================
    // NETTOYER LE NOUVEAU NOM
    // ==============================

    var safeNewName =
        SanitizeFolderName(newName);

    if (string.IsNullOrWhiteSpace(safeNewName))
        throw new Exception(
            "Nom de dossier invalide."
        );


    // ==============================
    // VÉRIFIER LE DOUBLON
    // ==============================

    await using (var connection = _factory.Create())
    {
        await connection.OpenAsync();

        const string sql = """
            SELECT COUNT(*)
            FROM FILE_FOLDERS
            WHERE NVL(PARENT_ID, 0) = NVL(:parentId, 0)
              AND NAME = :name
              AND ID <> :id
            """;

        await using var command =
            new OracleCommand(sql, connection);

        command.Parameters.Add(
            "parentId",
            OracleDbType.Int64
        ).Value =
            folder.ParentId.HasValue
                ? folder.ParentId.Value
                : DBNull.Value;

        command.Parameters.Add(
            "name",
            OracleDbType.Varchar2
        ).Value = safeNewName;

        command.Parameters.Add(
            "id",
            OracleDbType.Int64
        ).Value = folderId;

        var count =
            Convert.ToInt32(
                await command.ExecuteScalarAsync()
            );

        if (count > 0)
        {
            throw new Exception(
                $"Le dossier '{safeNewName}' existe déjà."
            );
        }
    }


    // ==============================
    // ANCIEN CHEMIN PHYSIQUE
    // ==============================

    var oldPhysicalPath =
        await GetFolderPhysicalPathAsync(
            folderId
        );


    // Le dossier doit réellement exister
    if (!Directory.Exists(oldPhysicalPath))
    {
        throw new DirectoryNotFoundException(
            $"Le dossier physique n'existe pas : {oldPhysicalPath}"
        );
    }


    // ==============================
    // NOUVEAU CHEMIN PHYSIQUE
    // ==============================

    var parentPhysicalPath =
        folder.ParentId.HasValue
            ? await GetFolderPhysicalPathAsync(
                folder.ParentId.Value
            )
            : StorageRoot;

    var newPhysicalPath =
        Path.Combine(
            parentPhysicalPath,
            safeNewName
        );


    // ==============================
    // VÉRIFIER DESTINATION
    // ==============================

    if (Directory.Exists(newPhysicalPath))
    {
        throw new IOException(
            $"Le dossier physique '{safeNewName}' existe déjà."
        );
    }


    // ==============================
    // RENOMMER PHYSIQUEMENT
    // ==============================

    Directory.Move(
        oldPhysicalPath,
        newPhysicalPath
    );


    try
    {
        // ==============================
        // MISE À JOUR ORACLE
        // ==============================

        await using var connection =
            _factory.Create();

        await connection.OpenAsync();

        await using var transaction =
            await connection.BeginTransactionAsync();

        try
        {
            const string sql = """
                UPDATE FILE_FOLDERS
                SET
                    NAME = :name,
                    UPDATED_AT = SYSTIMESTAMP
                WHERE ID = :id
                """;

            await using var command =
                new OracleCommand(
                    sql,
                    connection
                );

            command.Transaction =
                (OracleTransaction)transaction;

            command.Parameters.Add(
                "name",
                OracleDbType.Varchar2
            ).Value = safeNewName;

            command.Parameters.Add(
                "id",
                OracleDbType.Int64
            ).Value = folderId;

            await command.ExecuteNonQueryAsync();


            // ====================================
            // METTRE À JOUR LES CHEMINS DES FICHIERS
            // ====================================

            await UpdateDescendantFilePathsAsync(
                connection,
                transaction,
                folderId
            );


            await transaction.CommitAsync();
        }
        catch
        {
            await transaction.RollbackAsync();
            throw;
        }
    }
    catch
    {
        // Oracle a échoué :
        // on remet le dossier physique
        // à son ancien emplacement.

        if (Directory.Exists(newPhysicalPath))
        {
            Directory.Move(
                newPhysicalPath,
                oldPhysicalPath
            );
        }

        throw;
    }
}


