3. Modifiez openViewer()

function openViewer(id) {

    const selectedFile = documents.find(
        file => file.id === id
    );

    if (!selectedFile) return;


    currentDocument = selectedFile;


    // Mobile
    const isMobile =
        window.matchMedia("(max-width: 800px)").matches;


    if (isMobile) {

        window.open(
            selectedFile.url,
            "_blank"
        );

        return;
    }


    const viewer =
        document.getElementById(
            "pdfViewerPanel"
        );


    const pdf =
        document.getElementById(
            "pdfViewer"
        );


    const title =
        document.getElementById(
            "viewerTitle"
        );


    title.textContent =
        selectedFile.name;


    pdf.src =
        selectedFile.url +
        "#toolbar=1&navpanes=1";


    /*
       Animation d'ouverture
    */

    viewer.classList.add("open");

}


---

4. Modifiez closeViewer()

function closeViewer() {

    const viewer =
        document.getElementById(
            "pdfViewerPanel"
        );

    const pdf =
        document.getElementById(
            "pdfViewer"
        );


    /*
       Lance l'animation de fermeture
    */

    viewer.classList.remove("open");


    /*
       On vide le PDF après l'animation
       pour libérer la mémoire
    */

    setTimeout(() => {

        pdf.src = "";

        currentDocument = null;

        document.getElementById(
            "viewerTitle"
        ).textContent =
            "Aucun document sélectionné";

    }, 300);

}

Le comportement devient

Au chargement :

┌───────────────┬───────────────────────────────┐
│ 📁 Dossiers   │                               │
│               │       Documents               │
│ 📂 Rapports   │                               │
│ 📂 Décisions  │       [ PDF ]                 │
│               │                               │
└───────────────┴───────────────────────────────┘

Le viewer est totalement invisible.


---

Clic sur un PDF :

→ animation →

┌───────────────┬───────────────────────────────┐
│ 📁 Dossiers   │     Rapport_2025.pdf     ⛶ ↗ ×│
│               │───────────────────────────────│
│ 📂 Rapports   │                               │
│               │          PDF                  │
│               │                               │
└───────────────┴───────────────────────────────┘

Le viewer arrive de la droite avec un léger fondu.


---

Clic sur × :

← animation ←

┌───────────────┬───────────────────────────────┐
│ 📁 Dossiers   │                               │
│               │       Documents               │
│ 📂 Rapports   │                               │
│ 📂 Décisions  │       [ PDF ]                 │
└───────────────┴───────────────────────────────┘

Le viewer repart vers la droite puis est masqué.

Sur mobile

On conserve votre règle précédente :

clic sur PDF → ouverture directe dans un nouvel onglet, sans afficher le viewer intégré.

Ainsi, vous avez trois comportements cohérents :

Action	Desktop	Mobile

Chargement	Viewer caché	Viewer caché
Sélection PDF	Viewer animé	Nouvel onglet
×	Fermeture animée	—
⛶	Plein écran	—
↗	Nouvel onglet	Déjà ouvert dans nouvel onglet