3. ActualiteModal.tsx

"use client";

import { FormEvent, useEffect, useState } from "react";
import { Actualite } from "./ActualitesTable";
import styles from "./actualites.module.css";

interface Props {
  actualite: Actualite | null;
  onFermer: () => void;
  onEnregistrer: (
    actualite: Omit<Actualite, "id"> & {
      id?: number;
    }
  ) => void;
}

export default function ActualiteModal({
  actualite,
  onFermer,
  onEnregistrer,
}: Props) {
  const [titre, setTitre] = useState("");
  const [description, setDescription] = useState("");
  const [paragraphe, setParagraphe] = useState("");
  const [categorie, setCategorie] = useState("Politique");
  const [date, setDate] = useState("");
  const [motsCles, setMotsCles] = useState<string[]>([]);
  const [nouveauMot, setNouveauMot] = useState("");

  const modeModification = actualite !== null;

  useEffect(() => {
    if (actualite) {
      setTitre(actualite.titre);
      setDescription(actualite.description);
      setParagraphe(actualite.paragraphe);
      setCategorie(actualite.categorie);
      setDate(actualite.date);
      setMotsCles(actualite.motsCles);
    } else {
      setTitre("");
      setDescription("");
      setParagraphe("");
      setCategorie("Politique");
      setDate(
        new Date().toISOString().split("T")[0]
      );
      setMotsCles([]);
    }
  }, [actualite]);

  const ajouterMotCle = () => {
    const mot = nouveauMot.trim();

    if (!mot) return;

    if (
      !motsCles.some(
        (item) => item.toLowerCase() === mot.toLowerCase()
      )
    ) {
      setMotsCles((ancienneListe) => [
        ...ancienneListe,
        mot,
      ]);
    }

    setNouveauMot("");
  };

  const supprimerMotCle = (mot: string) => {
    setMotsCles((ancienneListe) =>
      ancienneListe.filter((item) => item !== mot)
    );
  };

  const handleKeyDown = (
    e: React.KeyboardEvent<HTMLInputElement>
  ) => {
    if (e.key === "Enter") {
      e.preventDefault();
      ajouterMotCle();
    }
  };

  const handleSubmit = (
    e: FormEvent<HTMLFormElement>
  ) => {
    e.preventDefault();

    if (!titre.trim()) {
      alert("Le titre est obligatoire.");
      return;
    }

    if (!description.trim()) {
      alert("La description est obligatoire.");
      return;
    }

    if (!paragraphe.trim()) {
      alert("Le paragraphe est obligatoire.");
      return;
    }

    if (!date) {
      alert("La date est obligatoire.");
      return;
    }

    onEnregistrer({
      id: actualite?.id,
      titre: titre.trim(),
      description: description.trim(),
      paragraphe: paragraphe.trim(),
      categorie,
      date,
      motsCles,
    });
  };

  return (
    <div
      className={styles.modalOverlay}
      onMouseDown={(e) => {
        if (e.target === e.currentTarget) {
          onFermer();
        }
      }}
    >
      <div className={styles.modal}>
        {/* HEADER */}
        <div className={styles.modalHeader}>
          <div>
            <h2 className={styles.modalTitle}>
              {modeModification
                ? "Modifier l'actualité"
                : "Ajouter une actualité"}
            </h2>

            <p className={styles.modalSubtitle}>
              {modeModification
                ? "Modifiez les informations de cette actualité."
                : "Ajoutez une nouvelle actualité au portail."}
            </p>
          </div>

          <button
            type="button"
            className={styles.closeButton}
            onClick={onFermer}
          >
            ×
          </button>
        </div>

        {/* FORM */}
        <form
          onSubmit={handleSubmit}
          className={styles.form}
        >
          <div className={styles.formGroup}>
            <label>
              Titre <span>*</span>
            </label>

            <input
              type="text"
              value={titre}
              onChange={(e) =>
                setTitre(e.target.value)
              }
              placeholder="Titre de l'actualité"
              className={styles.input}
            />
          </div>

          <div className={styles.formGroup}>
            <label>
              Description <span>*</span>
            </label>

            <textarea
              value={description}
              onChange={(e) =>
                setDescription(e.target.value)
              }
              placeholder="Courte description..."
              rows={3}
              className={styles.textarea}
            />
          </div>

          <div className={styles.formGroup}>
            <label>
              Paragraphe <span>*</span>
            </label>

            <textarea
              value={paragraphe}
              onChange={(e) =>
                setParagraphe(e.target.value)
              }
              placeholder="Contenu complet de l'actualité..."
              rows={7}
              className={styles.textarea}
            />
          </div>

          <div className={styles.formGrid}>
            <div className={styles.formGroup}>
              <label>Catégorie</label>

              <select
                value={categorie}
                onChange={(e) =>
                  setCategorie(e.target.value)
                }
                className={styles.input}
              >
                <option value="Politique">
                  Politique
                </option>
                <option value="Économie">
                  Économie
                </option>
                <option value="Technologie">
                  Technologie
                </option>
                <option value="Événement">
                  Événement
                </option>
                <option value="Développement">
                  Développement
                </option>
                <option value="Formation">
                  Formation
                </option>
              </select>
            </div>

            <div className={styles.formGroup}>
              <label>
                Date <span>*</span>
              </label>

              <input
                type="date"
                value={date}
                onChange={(e) =>
                  setDate(e.target.value)
                }
                className={styles.input}
              />
            </div>
          </div>

          {/* TAGS */}
          <div className={styles.formGroup}>
            <label>Mots clés</label>

            <div className={styles.tagsInput}>
              {motsCles.map((mot) => (
                <span
                  key={mot}
                  className={styles.formTag}
                >
                  {mot}

                  <button
                    type="button"
                    onClick={() =>
                      supprimerMotCle(mot)
                    }
                  >
                    ×
                  </button>
                </span>
              ))}

              <input
                type="text"
                value={nouveauMot}
                onChange={(e) =>
                  setNouveauMot(e.target.value)
                }
                onKeyDown={handleKeyDown}
                placeholder={
                  motsCles.length === 0
                    ? "Ajouter un mot clé..."
                    : "Ajouter..."
                }
              />
            </div>

            <small>
              Appuyez sur Entrée pour ajouter un mot clé.
            </small>
          </div>

          {/* ACTIONS */}
          <div className={styles.modalActions}>
            <button
              type="button"
              onClick={onFermer}
              className={styles.cancelButton}
            >
              Annuler
            </button>

            <button
              type="submit"
              className={styles.saveButton}
            >
              {modeModification
                ? "Enregistrer les modifications"
                : "Ajouter l'actualité"}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}


